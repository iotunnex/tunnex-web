# Copy to .dev.vars for local development (gitignored).
# Production secrets are set with `wrangler secret put <NAME>` — never in wrangler.toml.
#
# No secrets are required yet. Future stories add:
#   RESEND_API_KEY    (S2.1)
#   TURNSTILE_SECRET  (S2.2)

# Optional local override of the launch mode (defaults to "prelaunch"):
# LAUNCH_MODE=prelaunch
