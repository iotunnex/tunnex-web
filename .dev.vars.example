# Copy to .dev.vars for local development (gitignored).
# Production secrets are set with `wrangler secret put <NAME>` — never in wrangler.toml.
# Cloudflare account credentials are CI-ONLY (GitHub Actions secrets) — never on a laptop.

# --- Secrets used by the site Worker ---

# Resend API key for outbound email via mail.tunnex.io (S2.1 mailer +
# scripts/test-send.mjs). Local dev can use a Resend test-mode key.
# RESEND_API_KEY=re_...

# Cloudflare Turnstile secret key for server-side form verification (S2.2+).
# Local dev: use the official test secret (always passes, matches the default
# test sitekey baked into PUBLIC_TURNSTILE_SITE_KEY):
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- Optional local overrides ---

# Launch mode override (defaults to "prelaunch"):
# LAUNCH_MODE=prelaunch
