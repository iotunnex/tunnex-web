{
  "name": "tunnex-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-og.mjs && node scripts/generate-email-logo.mjs && astro build",
    "preview": "astro build && wrangler dev",
    "typecheck": "wrangler types && astro check",
    "db:migrate:local": "wrangler d1 migrations apply tunnex-site-db --local",
    "lint": "eslint . && node scripts/lint-tokens.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "axe": "node scripts/axe-scan.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
    "disposable-email-domains": "^1.0.62",
    "psl": "^1.15.0",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@fontsource/inter": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "satori": "^0.26.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
