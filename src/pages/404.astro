---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Logo from '../components/Logo.astro';
---

<Base
  title="Tunnex — Page not found"
  description="This page doesn’t exist — or doesn’t exist yet."
  noindex
>
  <section
    class="mx-auto flex min-h-[60vh] w-full max-w-6xl flex-col items-center justify-center gap-6 px-4 py-20 text-center sm:px-6"
  >
    <Logo variant="vertical" />
    <h1 class="text-2xl font-bold tracking-tight">Page not found</h1>
    <p class="max-w-md text-sm text-text-muted">
      This page doesn’t exist — or doesn’t exist yet. Nothing here is load-bearing: your VPN
      wouldn’t care either way.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href="/" variant="primary">Back to tunnex.io</Button>
      <Button href="/docs/" variant="secondary">Read the docs</Button>
    </div>
  </section>
</Base>
