---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import TurnstileWidget from '../components/TurnstileWidget.astro';

// S3.2: the real trial-request form (replaces the interim placeholder on the
// same route). Static page + fetch POST — the endpoint's response is the
// byte-identical generic message in every case, shown inline.
---

<Base
  title="Tunnex — Start your 14-day Enterprise trial"
  description="Request a 14-day Tunnex Enterprise trial for your company domain. One trial per domain, bound to a verified work email."
>
  <section class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-20">
    <div class="flex flex-col gap-4 self-start md:sticky md:top-24">
      <h1 class="text-4xl font-bold tracking-tight">Start your 14-day Enterprise trial</h1>
      <p class="max-w-md text-lg text-text-muted">
        One trial per company domain, bound to a verified work email. Request it, confirm from your
        inbox within 30 minutes, and your 14 days start only when your license key is issued — at
        beta launch, not a moment before.
      </p>
      <ul class="flex flex-col gap-2 text-sm text-text-muted">
        <li>· Everything in Enterprise: SSO, Zero Trust policies, multi-org</li>
        <li>· No card, no sales call required</li>
        <li>· Lapses to the free Open tier — the VPN keeps running</li>
      </ul>
      <p class="text-sm text-text-muted">
        Questions first? Write to{' '}
        <a href="mailto:sales@tunnex.io" class="font-semibold text-link">sales@tunnex.io</a>.
      </p>
    </div>

    <Card class="p-5 sm:p-8">
      <form id="trial-form" class="flex flex-col gap-4" novalidate>
        <div class="flex flex-col gap-1.5">
          <label for="trial-email" class="text-sm font-medium">Work email</label>
          <input
            id="trial-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@company.com"
            aria-describedby="trial-email-hint trial-email-error"
            class="rounded-md border border-border bg-surface-raised px-3 py-2.5 text-base text-text placeholder:text-text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-[invalid=true]:border-error sm:text-sm"
          />
          <p id="trial-email-hint" class="text-xs text-text-muted">
            The trial binds to your company domain — consumer and disposable addresses won’t work.
          </p>
          <p id="trial-email-error" class="text-sm font-medium text-error empty:hidden"></p>
        </div>
        <noscript>
          <style>
            #trial-form #turnstile-widget,
            #trial-form button {
              display: none;
            }
          </style>
          <p class="text-sm text-text-muted">
            The captcha needs JavaScript. Without it, email{' '}
            <a href="mailto:sales@tunnex.io?subject=Tunnex%20trial" class="font-semibold text-link">
              sales@tunnex.io
            </a>{' '}
            instead.
          </p>
        </noscript>
        <TurnstileWidget />
        <Button variant="primary" class="w-full">Request trial</Button>
        <p id="trial-status" role="status" class="text-sm empty:hidden"></p>
      </form>
    </Card>

    <ol class="grid gap-6 border-t border-border pt-10 sm:grid-cols-3 md:col-span-2">
      <li class="flex flex-col gap-1">
        <span class="text-xs font-semibold tracking-wide text-text-muted uppercase">Step 1</span>
        <span class="font-semibold">Request</span>
        <span class="text-sm text-text-muted">
          Enter your work email and we send a verification link, valid for 30 minutes.
        </span>
      </li>
      <li class="flex flex-col gap-1">
        <span class="text-xs font-semibold tracking-wide text-text-muted uppercase">Step 2</span>
        <span class="font-semibold">Confirm</span>
        <span class="text-sm text-text-muted">
          Click the link and the trial is reserved for your domain.
        </span>
      </li>
      <li class="flex flex-col gap-1">
        <span class="text-xs font-semibold tracking-wide text-text-muted uppercase">Step 3</span>
        <span class="font-semibold">Get your key</span>
        <span class="text-sm text-text-muted">
          Your license key arrives when the beta opens — your 14 days start then.
        </span>
      </li>
    </ol>
  </section>
</Base>

<script>
  // Client fallback must mirror the server's GENERIC_TRIAL_MESSAGE exactly —
  // asserting "check your inbox" would undo the anti-enumeration hedge.
  const GENERIC_FALLBACK =
    'If your domain is eligible, a verification link is on its way to your inbox. It is valid for 30 minutes.';

  const form = document.getElementById('trial-form') as HTMLFormElement | null;
  const status = document.getElementById('trial-status');
  const emailError = document.getElementById('trial-email-error');
  const submitButton = form?.querySelector('button');
  let submitting = false;

  function setStatus(message: string, kind: 'neutral' | 'success' | 'error'): void {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('text-error', kind === 'error');
    status.classList.toggle('text-success', kind === 'success');
    status.classList.toggle('text-text-muted', kind === 'neutral');
    status.classList.toggle('font-medium', kind !== 'neutral');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (submitting) return;

    const emailInput = form.elements.namedItem('email') as HTMLInputElement;
    const turnstileToken =
      (form.querySelector('input[name="cf-turnstile-response"]') as HTMLInputElement | null)
        ?.value ?? '';

    if (!emailInput.validity.valid) {
      emailInput.setAttribute('aria-invalid', 'true');
      if (emailError) emailError.textContent = 'Enter a valid work email address.';
      emailInput.focus();
      return;
    }
    if (!turnstileToken) {
      setStatus('Complete the captcha, then try again.', 'error');
      return;
    }

    submitting = true;
    if (submitButton) submitButton.disabled = true;
    form.setAttribute('aria-busy', 'true');
    setStatus('Sending…', 'neutral');
    try {
      const res = await fetch('/api/trial/request', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: emailInput.value, turnstileToken }),
      });
      const body = (await res.json()) as { message?: string; error?: { message?: string } };
      if (res.ok) {
        setStatus(body.message ?? GENERIC_FALLBACK, 'success');
        form.reset();
      } else {
        setStatus(body.error?.message ?? 'Something went wrong. Try again shortly.', 'error');
      }
    } catch {
      setStatus('Network error. Try again shortly.', 'error');
    } finally {
      // Turnstile tokens are single-use — reset on every outcome or the retry
      // submits a consumed token.
      // @ts-expect-error Turnstile global from the widget script
      window.turnstile?.reset();
      submitting = false;
      if (submitButton) submitButton.disabled = false;
      form.removeAttribute('aria-busy');
    }
  });

  document.getElementById('trial-email')?.addEventListener('input', (event) => {
    (event.currentTarget as HTMLInputElement).removeAttribute('aria-invalid');
    if (emailError) emailError.textContent = '';
  });
</script>
