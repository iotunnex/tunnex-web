---
import { TRIAL_LENGTH_ADJ, TRIAL_LENGTH_NOUN } from '../lib/issuance.ts';
import Base from '../layouts/Base.astro';
import TurnstileWidget from '../components/TurnstileWidget.astro';
import { launchMode } from '../config';

const isBeta = launchMode === 'beta';

const trialBullets = [
  'Everything in Enterprise: SSO, Zero Trust policies, multi-org',
  'No card, no sales call required',
  'Lapses to the free Open tier — the VPN keeps running',
];

const steps = [
  {
    n: '1',
    title: 'Request',
    body: 'Enter your work email and we send a verification link, valid for 30 minutes.',
  },
  { n: '2', title: 'Confirm', body: 'Click the link and the trial is reserved for your domain.' },
  {
    n: '3',
    title: 'Get your key',
    body: isBeta
      ? `Your license key is issued on confirmation — your ${TRIAL_LENGTH_NOUN} start then.`
      : `Your license key arrives when the beta opens — your ${TRIAL_LENGTH_NOUN} start then.`,
  },
];
---

<Base
  title={`Start your ${TRIAL_LENGTH_ADJ} Enterprise trial — Tunnex`}
  description={`Request a ${TRIAL_LENGTH_ADJ} Tunnex Enterprise trial for your company domain. One trial per domain, bound to a verified work email.`}
>
  <div
    class="mx-auto max-w-[1180px] px-7 py-18 md:py-[72px] flex flex-col gap-10 max-[620px]:px-[18px]"
  >
    <!-- Header -->
    <div class="flex flex-col gap-3.5 max-w-[68ch]">
      <div class="tnx-eyebrow">ENTERPRISE TRIAL</div>
      <h1 class="tnx-h1">Start your {TRIAL_LENGTH_ADJ} Enterprise trial</h1>
      <div class="font-normal text-[16px] leading-[1.68] text-[#A9A9A6] text-pretty">
        {
          isBeta
            ? `One trial per company domain, bound to a verified work email. Request it, confirm from your inbox within 30 minutes, and your ${TRIAL_LENGTH_NOUN} start the moment your license key is issued.`
            : `One trial per company domain, bound to a verified work email. Request it, confirm from your inbox within 30 minutes, and your ${TRIAL_LENGTH_NOUN} start only when your license key is issued — at beta launch, not a moment before.`
        }
      </div>
    </div>

    <div class="t-g2 grid grid-cols-1 md:grid-cols-[1.05fr_0.95fr] gap-3.5 items-start">
      <!-- Left Column: Form -->
      <div
        class="t-card border border-white/9 rounded-lg bg-[rgba(18,18,18,0.72)] p-6.5 flex flex-col gap-4.5"
      >
        <div id="trial-form-container">
          {
            !isBeta && (
              <div class="border border-[#C9989C]/30 bg-[#B03A45]/12 rounded-md p-3.5 mb-4.5 flex items-center gap-3">
                <div class="size-2 rounded-full bg-[#B03A45] shrink-0 animate-pulse" />
                <div class="font-normal text-[12.5px] leading-[1.5] text-[#EDEDEB]">
                  <strong class="font-semibold text-[#F5F5F5]">PRELAUNCH · COMING SOON:</strong> We
                  are currently building Tunnex! Requesting access reserves your license key to be
                  delivered as Public Beta opens.
                </div>
              </div>
            )
          }
          <!-- Dynamic client-side error alert -->
          <div
            id="trial-error-alert"
            class="hidden border border-error/40 bg-error/15 rounded-md p-3.5 mb-4 items-center gap-3 transition-all"
          >
            <div class="size-2 rounded-full bg-error shrink-0"></div>
            <div id="trial-error-text" class="font-normal text-[12.5px] leading-[1.5] text-text">
              Verification request failed. Please check your email address.
            </div>
          </div>
          <form id="trial-form" class="flex flex-col gap-4.5" novalidate>
            <div class="flex flex-col gap-2.25">
              <label
                for="trial-email"
                class="font-mono font-semibold text-[9px] tracking-[0.16em] text-[#5E5E5B] uppercase"
                >WORK EMAIL</label
              >
              <input
                id="trial-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@company.com"
                class="bg-[#121212] border border-[#2E2E2E] rounded-md px-3.25 py-3 font-normal text-[14.5px] text-[#EDEDEB] shadow-[inset_0_1px_3px_rgba(0,0,0,0.22)] focus:outline-none"
              />
              <div class="font-normal text-[12.5px] leading-[1.6] text-[#5E5E5B]">
                The trial binds to your company domain — consumer and disposable addresses won’t
                work.
              </div>
            </div>

            <TurnstileWidget />

            <button
              id="trial-submit-btn"
              type="submit"
              class="t-btn t-prim w-full text-center rounded-[9px] px-5 py-3.5 font-semibold text-[14px] cursor-pointer"
            >
              Request trial
            </button>

            <div class="font-normal text-[12.5px] leading-[1.6] text-[#5E5E5B]">
              Questions first? Write to <a
                href="mailto:sales@tunnex.io"
                class="underline underline-offset-4 decoration-[#C9C9C4]/40 hover:text-[#EDEDEB]"
                >sales@tunnex.io</a
              >.
            </div>
          </form>
        </div>

        <div id="trial-sent-box" class="hidden flex flex-col gap-2.75">
          <div class="flex items-center gap-2.5">
            <span class="lic size-4.5 shrink-0 text-[#6E9C7C]">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-full"
                ><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"
                ></path></svg
              >
            </span>
            <div class="font-semibold text-[16px] text-[#F5F5F5]">
              If your domain is eligible, a verification link is on its way
            </div>
          </div>
          <div class="font-normal text-[14px] leading-[1.66] text-[#858582]">
            The link is valid for 30 minutes. Clicking it opens a confirmation page — nothing is
            reserved until you confirm there.
          </div>
          <button
            id="trial-reset-btn"
            type="button"
            class="t-btn t-sec self-start rounded-[9px] px-4.5 py-2.75 font-semibold text-[13px] cursor-pointer mt-1"
          >
            Use a different address
          </button>
        </div>
      </div>

      <!-- Right Column: Benefits & Steps -->
      <div class="flex flex-col gap-3.5">
        <div
          class="bg-[rgba(18,18,18,0.72)] border border-white/[0.09] rounded-lg p-5 flex flex-col gap-2.75"
        >
          {
            trialBullets.map((b) => (
              <div class="flex items-start gap-2.5">
                <span class="lic size-3.75 shrink-0 text-[#6E9C7C] mt-0.5">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-full"
                  >
                    <>
                      <path d="M21.801 10A10 10 0 1 1 17 3.335" />
                      <path d="m9 11 3 3L22 4" />
                    </>
                  </svg>
                </span>
                <span class="font-normal text-[13.5px] leading-[1.55] text-[#A9A9A6]">{b}</span>
              </div>
            ))
          }
        </div>

        <div
          class="t-card border border-white/9 rounded-lg bg-[rgba(18,18,18,0.72)] p-5.5 flex flex-col gap-4"
        >
          <div
            class="font-mono font-semibold text-[9px] tracking-[0.16em] text-[#5E5E5B] uppercase"
          >
            HOW IT WORKS
          </div>
          {
            steps.map((s) => (
              <div class="t-row flex gap-3.25 items-start rounded-lg p-1">
                <div class="size-6 shrink-0 rounded-full border border-[#2E2E2E] bg-[#1A1A1A] flex items-center justify-center font-mono font-semibold text-[11px] text-[#C9C9C4]">
                  {s.n}
                </div>
                <div>
                  <div class="font-semibold text-[13.5px] text-[#EDEDEB]">{s.title}</div>
                  <div class="font-normal text-[12.5px] leading-[1.6] text-[#858582] mt-0.75">
                    {s.body}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Base>

<script is:inline>
  const form = document.getElementById('trial-form');
  const formBox = document.getElementById('trial-form-container');
  const sentBox = document.getElementById('trial-sent-box');
  const resetBtn = document.getElementById('trial-reset-btn');
  const submitBtn = document.getElementById('trial-submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailInput = document.getElementById('trial-email');
    const email = emailInput?.value?.trim();
    const turnstileToken =
      document.querySelector('[name="cf-turnstile-response"]')?.value || 'local-dev-token';

    if (!email) return;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending link...';
    }

    try {
      const res = await fetch('/api/trial/request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, turnstileToken }),
      });

      if (res.ok && formBox && sentBox) {
        formBox.classList.add('hidden');
        sentBox.classList.remove('hidden');
      } else {
        const data = await res.json().catch(() => ({}));
        const errAlert = document.getElementById('trial-error-alert');
        const errText = document.getElementById('trial-error-text');
        if (errAlert && errText) {
          errText.textContent =
            data.message || 'Verification request failed. Please check your email address.';
          errAlert.classList.remove('hidden');
          errAlert.classList.add('flex');
          errAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    } catch (err) {
      console.error(err);
      if (formBox && sentBox) {
        formBox.classList.add('hidden');
        sentBox.classList.remove('hidden');
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Request trial';
      }
    }
  });

  resetBtn?.addEventListener('click', () => {
    if (formBox && sentBox) {
      sentBox.classList.add('hidden');
      formBox.classList.remove('hidden');
    }
  });
</script>
