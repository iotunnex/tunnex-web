---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { launchMode } from '../config';

const isBeta = launchMode === 'beta';

const openFeatures = [
  'Self-hosted control plane, gateways, and clients',
  'Unlimited devices',
  'Single organization',
  'Local authentication',
  'WireGuard data plane',
  'Desktop + CLI clients',
];

const enterpriseFeatures = [
  'SSO: Google & Microsoft Entra',
  'Zero Trust access policies',
  'Multi-org (multi-tenant) management',
  'Kubernetes operator',
  'Priority support',
];
---

<Base
  title="Tunnex — Pricing"
  description="Tunnex is self-hosted either way: the Open core is free for unlimited devices; Enterprise adds SSO, Zero Trust policies, and multi-org management."
>
  <section class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-16 sm:px-6 md:py-20">
    <h1 class="text-4xl font-bold tracking-tight">Pricing</h1>
    <p class="max-w-2xl text-lg text-text-muted">
      Self-hosted either way. Your network runs on your infrastructure whether you pay us or not —
      Enterprise is for teams that need identity, policy, and scale.
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-4 pb-20 sm:px-6 lg:grid-cols-2">
    <!-- Open tier -->
    <div class="flex flex-col gap-6 rounded-lg border border-border bg-surface p-8">
      <div class="flex flex-col gap-1">
        <h2 class="text-lg font-semibold">Open</h2>
        <p class="text-4xl font-bold tracking-tight">Free</p>
        <p class="text-sm text-text-muted">Self-hosted, forever. No device caps, no seat math.</p>
      </div>
      <ul class="flex flex-col gap-3 text-sm">
        {
          openFeatures.map((f) => (
            <li class="flex items-start gap-2.5">
              <svg
                class="mt-0.5 size-4 shrink-0 text-success"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 12.5 10 18 20 6" />
              </svg>
              {f}
            </li>
          ))
        }
      </ul>
      <div class="mt-auto">
        <Button href={isBeta ? '/download' : '/docs'} variant="secondary" class="w-full">
          {isBeta ? 'Download' : 'Read the docs'}
        </Button>
      </div>
    </div>

    <!-- Enterprise tier -->
    <div class="flex flex-col gap-6 rounded-lg border-2 border-primary bg-surface p-8">
      <div class="flex flex-col gap-1">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold">Enterprise</h2>
          <span
            class="rounded-full border border-border px-2 py-0.5 text-[11px] font-medium tracking-wide text-text-muted uppercase"
          >
            14-day free trial
          </span>
        </div>
        <p class="text-4xl font-bold tracking-tight">Custom</p>
        <p class="text-sm text-text-muted">
          Per-seat, billed annually. Priced for your team — talk to us.
        </p>
      </div>
      <p class="text-sm font-medium">Everything in Open, plus:</p>
      <ul class="flex flex-col gap-3 text-sm">
        {
          enterpriseFeatures.map((f) => (
            <li class="flex items-start gap-2.5">
              <svg
                class="mt-0.5 size-4 shrink-0 text-success"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 12.5 10 18 20 6" />
              </svg>
              {f}
            </li>
          ))
        }
      </ul>
      {
        /*
        EPIC 7 CHECKOUT SLOT — structural mount point, do not remove.
        When payments land (Stripe US + Razorpay India, trigger: product S12.5),
        the checkout flow replaces the contents of this container. Until then it
        carries the trial + sales CTAs.
      */
      }
      <div id="checkout-slot" data-slot="checkout" class="mt-auto flex flex-col gap-3">
        <Button href="/trial" variant="primary" class="w-full">Start 14-day free trial</Button>
        <Button href="/enterprise" variant="secondary" class="w-full">Contact sales</Button>
      </div>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-12 sm:px-6">
      <h2 class="text-lg font-semibold">Not sure which tier?</h2>
      <p class="max-w-2xl text-sm text-text-muted">
        If your team signs in with Google or Microsoft, needs per-resource access policies, or runs
        more than one organization, you want Enterprise. Otherwise start with Open — upgrading later
        is a license key, not a migration.
      </p>
    </div>
  </section>
</Base>
