---
import { TRIAL_LENGTH_ADJ } from '../lib/issuance.ts';
import Base from '../layouts/Base.astro';
import CapabilitiesBento from '../components/CapabilitiesBento.astro';
import WhyTunnexSection from '../components/WhyTunnexSection.astro';
import QuickstartSection from '../components/QuickstartSection.astro';
import WhoRunsTunnexSection from '../components/WhoRunsTunnexSection.astro';
import OpenCoreSection from '../components/OpenCoreSection.astro';

const capGroups = [
  {
    icon: 'network',
    title: 'Core VPN & networking',
    ent: false,
    items: [
      'WireGuard data plane, self-hosted, multi-tenant from the schema up',
      'One docker compose up brings the whole stack up and generates every secret on first boot',
      'Pipe-safe install.sh: idempotent, asks for a public address and SMTP or skip',
      'Prebuilt images from ghcr.io: no cloning, no building from source',
      'Per-org address pool with deterministic allocation and safe resize, orphans detected',
      'Control plane / data plane split: the API never touches WireGuard; a node agent owns it',
      'Desired-state reconciliation: data-plane state is reconciled, never assumed in sync',
      'Full-tunnel and split-tunnel routing, gateway egress NAT and IP forwarding',
      'A control-plane outage never kills running tunnels: agents keep reconciling',
    ],
  },
  {
    icon: 'route',
    title: 'Site-to-site networking',
    ent: false,
    items: [
      'Sites as first-class entities, each owning a gateway',
      'Route propagation between sites, hub-and-spoke, reconciled by agents',
      'Proven cross-cloud: AWS Sydney to Azure West US, 138ms, un-NAT’d',
      'Subnet advertisement with admin approval and org-wide disjointness validation',
      'Overlapping subnets refused with a typed error, never silently ambiguous',
      'Hub high availability: multi-hub failover with warm standby tunnels',
      'Cross-site DNS with split-horizon per-site forwarding',
      'Routed subnets and push routes (Pritunl parity)',
      'Zero-touch gateway: a gateway joins on one emitted command; no SSH after join',
    ],
  },
  {
    icon: 'shield',
    title: 'Zero Trust access',
    ent: true,
    items: [
      'Default-deny model, allow-only, deterministic policy compiler',
      'Subjects: group, user, site, or CIDR down to a single /32 host',
      'Destinations: resource (CIDR + port), site, or Kubernetes service',
      'Port- and protocol-scoped rules: tcp, udp, any, with port ranges',
      'Per-user grants and time-boxed grants: extensible, auto-expiring, swept',
      'Per-rule enable and disable toggle',
      'Enforcement at the gateway kernel: routed is not permitted',
      'Fail-closed cold start: a gateway that never received policy denies all',
      'Revocation is a full sweep: peer slot, pool address, live telemetry, all released',
      'Differentiated gateway health with named remedies',
    ],
  },
  {
    icon: 'key',
    title: 'Identity & authentication',
    ent: false,
    items: [
      'SSO with Google and Microsoft Entra ID over OIDC',
      'Local accounts (argon2id), email verification, password reset',
      'MFA and TOTP with recovery codes, org-level enforcement (Enterprise)',
      'IdP group sync: Entra groups become policy subjects, not a manual mirror',
      'Directory sync with two-tier health and a manual sync trigger',
      'RBAC: owner, admin, member (permission per feature)',
      'DNS-TXT verified domain capture, globally unique, public domains blocked',
      'Invitations, deactivation, and a full sweep of sessions and CLI credentials on reset',
    ],
  },
  {
    icon: 'monitor-smartphone',
    title: 'Device & posture',
    ent: true,
    items: [
      'Device approval gate: an admin approves before a device gets a tunnel',
      'Posture checks for OS version and disk encryption, configured per org',
      'Three-way honesty: compliant, blocked, or unknown (absence is never compliance)',
      'Continuous evaluation with a stale sweep',
      'Client-reported, not hardware attestation: stated plainly wherever it appears',
    ],
  },
  {
    icon: 'monitor',
    title: 'Clients',
    ent: false,
    items: [
      'Desktop client for Windows and macOS with its own purpose-built surface',
      'Kernel-level kill-switch: pf on macOS, WFP on Windows, fail-closed on process death',
      'Split-tunnel toggle, server picker, tray, notifications',
      'Revocation-aware teardown: no stale "Connected"',
      'tunnex CLI with browser-based login, SSO and MFA included',
      'Mobile via the official WireGuard apps; gateway-side Zero Trust still applies',
    ],
  },
  {
    icon: 'arrow-right-left',
    title: 'OpenVPN',
    ent: false,
    items: [
      'Full OpenVPN support alongside WireGuard — server lifecycle, PKI, per-user certs',
      '.ovpn export for standard clients: OpenVPN Connect, Tunnelblick, mobile',
      'CRL revocation with the identical full sweep — cert, address, status',
      'OpenVPN devices are Zero Trust subjects in the same compiled artifact, not a second door',
      'Per-org and per-gateway opt-in, off by default',
    ],
  },
  {
    icon: 'boxes',
    title: 'Kubernetes',
    ent: true,
    items: [
      'Helm charts for the control plane and the gateway',
      'In-cluster gateway exposes Services at synthetic VIPs, reachable by name over the tunnel',
      'GitOps operator and CRDs: TunnexCluster, TunnexExposedService, TunnexGrant',
      'Machine principals for automation with attributed audit',
      'Drift detection and self-healing',
    ],
  },
  {
    icon: 'line-chart',
    title: 'Visibility & operations',
    ent: false,
    items: [
      'Flow and access logs, kernel-stamped, per rule: allow, deny, aggregated deny, terminated',
      'Audit log with first-class system actors and a stated cause',
      'Prometheus metrics on a loopback-bound port, plus /readyz',
      'Leader election — N replicas serve, exactly one schedules',
      'Backup and restore with a keyed fingerprint; a wrong-key restore is refused',
      'Forward-only upgrades, restore-as-rollback, N/N-1 agent contract',
      'A preflight that refuses rather than warns',
      'Self-hosting guide with an honest-limits table',
    ],
  },
  {
    icon: 'file-text',
    title: 'Security posture',
    ent: false,
    items: [
      'Secrets encrypted at rest under a bootstrap master key',
      'Blocking CI security tier: govulncheck, CodeQL, gofmt and vet, SBOM',
      'Published SECURITY.md with a disclosure SLA',
      'Open core: Apache-2.0 core, Enterprise is source-available',
    ],
  },
  {
    icon: 'bot',
    title: 'Zero Trust for AI Agents & MCP',
    ent: true,
    items: [
      'Non-human AI agent principals with strict non-operator roles',
      'MCP (Model Context Protocol) server destination scoping (host, CIDR, port)',
      'Time-boxed access grants (expires_at) with automatic background sweep',
      'Attributed audit logging linking AI agent network requests to initiating triggers',
      'Prompt injection blast-radius containment: network-level default-deny prevents pivoting to unauthorized internal infrastructure',
      'Machine principal lifecycle: issuance, revocation, and automated session sweeps',
    ],
  },
];

const agentCards = [
  {
    icon: 'user-plus',
    title: 'Agents are owned',
    body: 'Every agent principal belongs to a human account. An ownerless principal sits outside the device cap and outside every accountability link while still costing an address, so we do not keep one.',
  },
  {
    icon: 'shield',
    title: 'Its own role, not the operator’s',
    body: 'An agent gets a role of its own. A machine credential that can write access rules is the threat model inverted: a compromised agent would grant itself what it was denied.',
  },
  {
    icon: 'refresh-cw',
    title: 'Grants that expire on their own',
    body: 'Access is a rule with an expiry that sweeps itself. A thirty-minute agent grant needs no new mechanism — extend moves the expiry in place, never delete-and-recreate.',
  },
  {
    icon: 'scroll-text',
    title: 'Attribution, including non-human actors',
    body: 'The audit log already carries a system actor and the cause of a change. A request from an agent is attributed to that agent, not to a blank field.',
  },
];

const roadmap = [
  'Per-tool enforcement inside MCP calls',
  'Agent payment (AP2) mandate awareness',
  'Native iOS and Android apps (mobile ships via the official WireGuard apps today)',
  'Runtime license key: paste a key, features unlock, no redeploy',
  'Code-signed and notarized desktop clients',
  'Auto-update for the desktop clients',
  'Connectivity checker: why can’t A reach B?',
  'Flow-log SIEM export and long-term retention',
  'NAT-mapped subnets for colliding branch LANs',
  'IPsec site-to-site for endpoints that cannot run an agent',
  'Rate limiting and API abuse protection',
  'EDR presence checks and hardware attestation',
];

const platforms = [
  { icon: 'monitor', name: 'macOS', note: 'DESKTOP CLIENT · UNSIGNED TODAY', fg: '#C39A4E' },
  { icon: 'monitor', name: 'Windows', note: 'DESKTOP CLIENT · UNSIGNED TODAY', fg: '#C39A4E' },
  { icon: 'terminal', name: 'Linux', note: 'CLI · X64 + ARM64', fg: '#6E6E6B' },
  { icon: 'boxes', name: 'Docker', note: 'COMPOSE · PREBUILT IMAGES', fg: '#6E6E6B' },
  { icon: 'boxes', name: 'Kubernetes', note: 'HELM + OPERATOR', fg: '#6E6E6B' },
  { icon: 'network', name: 'Any VPS', note: 'PUBLIC ADDRESS REQUIRED', fg: '#6E6E6B' },
  {
    icon: 'monitor-smartphone',
    name: 'iOS · Android',
    note: 'OFFICIAL WIREGUARD APPS',
    fg: '#C39A4E',
  },
  {
    icon: 'arrow-right-left',
    name: 'OpenVPN clients',
    note: '.OVPN EXPORT · CONNECT, TUNNELBLICK',
    fg: '#6E6E6B',
  },
  { icon: 'shield', name: 'Air-gapped', note: 'OFFLINE LICENCE VERIFY', fg: '#6E6E6B' },
];

const icons: Record<string, string> = {
  network:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>',
  route:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/></svg>',
  shield:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>',
  key: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>',
  'monitor-smartphone':
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M18 8V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h8"/><path d="M10 19v-3.96 3.15"/><path d="M7 19h5"/><rect width="6" height="10" x="16" y="12" rx="2"/></svg>',
  monitor:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>',
  'arrow-right-left':
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/></svg>',
  boxes:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"/><path d="m7 16.5-4.74-2.85"/><path d="m7 16.5 5-3"/><path d="M7 16.5v5.17"/><path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"/><path d="m17 16.5-5-3"/><path d="m17 16.5 4.74-2.85"/><path d="M17 16.5v5.17"/><path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"/><path d="M12 8 7.26 5.15"/><path d="m12 8 4.74-2.85"/><path d="M12 13.5V8"/></svg>',
  'line-chart':
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>',
  'file-text':
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>',
  'user-plus':
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>',
  'refresh-cw':
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>',
  'scroll-text':
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M15 12h-5"/><path d="M15 8h-5"/><path d="M19 17V5a2 2 0 0 0-2-2H4"/><path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"/></svg>',
  terminal:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>',
  bot: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>',
};
---

<Base
  title="Features & Capabilities — Tunnex Zero Trust VPN"
  description="Explore the complete capability inventory of Tunnex: Core VPN, Site-to-site, Zero Trust access, SSO, AI Agent & MCP governance, OpenVPN, and Kubernetes."
>
  <div
    class="mx-auto max-w-[1180px] px-7 py-18 md:py-[72px] flex flex-col gap-9 max-[620px]:px-[18px]"
  >
    <!-- Header -->
    <div class="flex flex-col gap-3.5 max-w-[66ch]">
      <div class="tnx-eyebrow">CAPABILITIES</div>
      <h1 class="tnx-h1">Everything Tunnex ships today</h1>
      <div class="font-normal text-[17px] leading-[1.65] text-[#A9A9A6] text-pretty">
        Self-hosted capabilities for both Open and Enterprise editions. Enterprise features are
        badged accordingly.
      </div>
    </div>

    <!-- 3 Stat Badges -->
    <div class="t-g3 grid grid-cols-1 sm:grid-cols-3 gap-3.5">
      <div class="bg-[rgba(18,18,18,0.72)] border border-white/[0.09] rounded-lg p-4.5">
        <div class="font-mono font-semibold text-[9px] tracking-[0.16em] text-[#454542]">
          CROSS-CLOUD SITE-TO-SITE
        </div>
        <div class="font-semibold text-[24px] text-[#EDEDEB] mt-1.5 tabular-nums">138ms</div>
        <div class="font-normal text-[12.5px] leading-[1.55] text-[#858582] mt-0.75">
          AWS Sydney to Azure West US, un-NAT'd, on a live wire.
        </div>
      </div>
      <div class="bg-[rgba(18,18,18,0.72)] border border-white/[0.09] rounded-lg p-4.5">
        <div class="font-mono font-semibold text-[9px] tracking-[0.16em] text-[#454542]">
          INSTALL
        </div>
        <div class="font-semibold text-[24px] text-[#EDEDEB] mt-1.5">One command</div>
        <div class="font-normal text-[12.5px] leading-[1.55] text-[#858582] mt-0.75">
          Prebuilt images, every secret generated on first boot. No building from source.
        </div>
      </div>
      <div class="bg-[rgba(18,18,18,0.72)] border border-white/[0.09] rounded-lg p-4.5">
        <div class="font-mono font-semibold text-[9px] tracking-[0.16em] text-[#454542]">
          CONTROL-PLANE OUTAGE
        </div>
        <div class="font-semibold text-[24px] text-[#EDEDEB] mt-1.5">Tunnels stay up</div>
        <div class="font-normal text-[12.5px] leading-[1.55] text-[#858582] mt-0.75">
          Agents keep reconciling. The plane hands out config; it never carries a packet.
        </div>
      </div>
    </div>
  </div>

  <!-- Sections moved from Home -->
  <CapabilitiesBento />
  <WhyTunnexSection />
  <QuickstartSection />
  <WhoRunsTunnexSection />
  <OpenCoreSection />

  <div class="mx-auto max-w-[1180px] px-7 py-14 flex flex-col gap-12 max-[620px]:px-[18px]">
    <!-- 10 Capability Group Items (Clean Minimal Hairline Layout) -->
    <div class="flex flex-col gap-4">
      <div class="tnx-eyebrow">DETAILED INVENTORY</div>
      <h2 class="tnx-h2">Complete technical capability specification</h2>
    </div>

    <div class="t-g2 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 items-start">
      {
        capGroups.map((g) => (
          <div class="border-t border-white/10 pt-6 flex flex-col gap-3.5">
            <div class="flex items-center gap-2.75">
              <div class="size-7 shrink-0 rounded-md bg-[#1A1A1A] border border-[#2E2E2E] flex items-center justify-center text-[#C9C9C4]">
                <Fragment set:html={icons[g.icon]} />
              </div>
              <div class="font-semibold text-[16px] text-[#F5F5F5]">{g.title}</div>
              {g.ent && (
                <span class="ml-auto font-mono font-semibold text-[8.5px] tracking-[0.08em] text-[#C39A4E] border border-[#2E2E2E] bg-[#141414] rounded-full px-2.25 py-0.75">
                  ENTERPRISE
                </span>
              )}
            </div>
            <div class="flex flex-col gap-2.25">
              {g.items.map((it) => (
                <div class="flex gap-2.5 items-start">
                  <span class="lic size-3.5 shrink-0 text-[#6E9C7C] mt-0.75">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="size-full"
                    >
                      <path d="M21.801 10A10 10 0 1 1 17 3.335" />
                      <path d="m9 11 3 3L22 4" />
                    </svg>
                  </span>
                  <span class="font-normal text-[13.5px] leading-[1.58] text-[#A9A9A6] text-pretty">
                    {it}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!-- Zero Trust for AI Agents (Roadmap) -->
    <div class="border-t border-white/10 pt-11 flex flex-col gap-9">
      <div class="t-g2 grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-2.5 flex-wrap">
            <div class="tnx-eyebrow">ZERO TRUST FOR AI AGENTS</div>
            <span
              class="font-mono font-semibold text-[8.5px] tracking-[0.1em] text-[#C39A4E] border border-[#2E2E2E] bg-[#1A1A1A] rounded-full px-2.25 py-0.75"
              >ROADMAP</span
            >
          </div>
          <h2 class="tnx-h2">An agent is a principal that runs unattended, at machine rate.</h2>
        </div>
        <div class="flex flex-col gap-4">
          <div class="font-normal text-[16px] leading-[1.68] text-[#A9A9A6] text-pretty">
            MCP servers today are deployed either on localhost — safe because unreachable — or on
            the public internet behind a bearer token and nothing else. There is no network boundary
            and no device identity between those two positions.
          </div>
          <div
            class="bg-[rgba(199,116,116,0.06)] border border-[rgba(199,116,116,0.24)] rounded-lg p-4 flex gap-3 items-start"
          >
            <span class="lic size-4 shrink-0 text-[#C77474] mt-0.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-full"
                ><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 20h16a2 2 0 0 0 1.73-2z"
                ></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg
              >
            </span>
            <div>
              <div class="font-semibold text-[13px] text-[#D6D6D2]">
                What a boundary does, and does not do
              </div>
              <div class="font-normal text-[13px] leading-[1.62] text-[#858582] mt-1 text-pretty">
                Zero trust bounds the blast radius of a correctly authenticated principal. It does
                not detect prompt injection. Under injection, authentication is intact and
                authorization is intact — only intent is corrupted.
              </div>
            </div>
          </div>
        </div>
