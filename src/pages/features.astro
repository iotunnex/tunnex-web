<script>
  // Stack collapse animation
  const boxes = document.querySelectorAll('.stack-box');
  const counter = document.getElementById('stack-counter');
  const foldedLabel = document.getElementById('stack-folded-label');
  const status = document.getElementById('stack-status');
  const star = document.getElementById('stack-star');
  const replay = document.getElementById('stack-replay');

  function runCollapse() {
    // Reset
    boxes.forEach((b) => {
      (b as HTMLElement).style.opacity = '1';
      (b as HTMLElement).style.transform = 'translateY(0) scale(1)';
    });
    if (counter) counter.textContent = '0 OF 6 FOLDED IN';
    if (foldedLabel) foldedLabel.textContent = '0 OF 6 FOLDED IN';
    if (status) status.textContent = 'assembling';
    if (star) (star as HTMLElement).style.opacity = '0';

    let folded = 0;
    boxes.forEach((b, i) => {
      setTimeout(
        () => {
          (b as HTMLElement).style.opacity = '0.15';
          (b as HTMLElement).style.transform = 'translateY(8px) scale(0.96)';
          folded++;
          if (counter) counter.textContent = `${folded} OF 6 FOLDED IN`;
          if (foldedLabel) foldedLabel.textContent = `${folded} OF 6 FOLDED IN`;
          if (folded === 6) {
            if (status) status.textContent = 'ready';
            if (star) (star as HTMLElement).style.opacity = '1';
          }
        },
        400 * (i + 1),
      );
    });
  }

  // Auto-run on viewport entry
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          runCollapse();
          observer.unobserve(e.target);
        }
      });
    },
    { threshold: 0.3 },
  );

  const area = document.getElementById('stack-collapse-area');
  if (area) observer.observe(area);
  if (replay) replay.addEventListener('click', runCollapse);
</script>
