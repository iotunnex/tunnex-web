---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import CodeSnippet from '../components/ui/CodeSnippet.astro';
import CtaPair from '../components/ui/CtaPair.astro';

// Internal design-system reference. Every element on this page consumes
// SEMANTIC tokens only — it is the acceptance surface for theme swaps.
---

<Base title="Tunnex — Style guide" description="Internal design-system reference.">
  <div class="mx-auto flex max-w-6xl flex-col gap-12 px-4 py-16 sm:px-6">
    <header class="flex flex-col gap-2">
      <p class="font-mono text-xs tracking-widest text-text-muted uppercase">
        internal · design system
      </p>
      <h1 class="text-3xl font-bold tracking-tight">Style guide</h1>
      <p class="max-w-2xl text-text-muted">
        Semantic-token components. Swapping the theme file restyles everything below with zero
        component edits.
      </p>
    </header>

    <section class="flex flex-col gap-4">
      <h2 class="text-xl font-semibold">Hero sample</h2>
      <Card class="flex flex-col gap-5 p-8">
        <h3 class="max-w-xl text-3xl font-bold tracking-tight text-balance">
          Self-hosted Zero Trust VPN.
        </h3>
        <p class="text-text-muted">Your keys. Your servers. Your network.</p>
        <CodeSnippet label="one-command install" class="max-w-lg">
          curl -fsSL https://get.tunnex.io | sh
        </CodeSnippet>
        <CtaPair
          primaryLabel="Start 14-day trial"
          primaryHref="/trial"
          secondaryLabel="Read the docs"
          secondaryHref="/docs"
        />
      </Card>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="text-xl font-semibold">Buttons</h2>
      <div class="flex flex-wrap items-center gap-3">
        <Button variant="primary">Primary action</Button>
        <Button variant="secondary">Secondary action</Button>
        <Button href="/docs" variant="primary">Primary link</Button>
        <Button href="/docs" variant="secondary">Secondary link</Button>
      </div>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="text-xl font-semibold">Cards</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <Card>
          <h3 class="text-base font-semibold">WireGuard data plane</h3>
          <p class="mt-2 text-sm text-text-muted">
            Modern crypto in the kernel path. Your traffic never touches our servers.
          </p>
          <a href="/security" class="mt-3 inline-block text-sm font-semibold text-link">
            Architecture →
          </a>
        </Card>
        <Card class="bg-surface-raised">
          <h3 class="text-base font-semibold">Raised surface</h3>
          <p class="mt-2 text-sm text-text-muted">
            Cards can sit on the raised surface token for emphasis.
          </p>
        </Card>
        <Card>
          <h3 class="text-base font-semibold">Muted body</h3>
          <p class="mt-2 text-sm text-text-muted">Body copy uses text-muted; headings use text.</p>
        </Card>
      </div>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="text-xl font-semibold">Status (semantic, non-brand)</h2>
      <div class="flex flex-wrap gap-3">
        <span class="rounded-md bg-success px-3 py-1.5 text-sm font-semibold text-success-fg">
          Tunnel up
        </span>
        <span class="rounded-md bg-warning px-3 py-1.5 text-sm font-semibold text-warning-fg">
          Key expiring
        </span>
        <span class="rounded-md bg-error px-3 py-1.5 text-sm font-semibold text-error-fg">
          Link down
        </span>
      </div>
      <div class="flex flex-wrap gap-6 text-sm font-medium">
        <span class="text-success">Success text</span>
        <span class="text-warning">Warning text</span>
        <span class="text-error">Error text</span>
      </div>
    </section>
  </div>
</Base>
