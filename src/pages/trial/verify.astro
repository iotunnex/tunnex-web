---
import { TRIAL_LENGTH_ADJ, TRIAL_LENGTH_NOUN } from '../../lib/issuance.ts';
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Logo from '../../components/Logo.astro';
import { d1TrialVerifyStore, peekTrialToken } from '../../lib/trial-verify.ts';
import { launchMode } from '../../config';

// Scanner-proof verification page: mail scanners (SafeLinks, Proofpoint)
// prefetch GET/HEAD — this page performs ZERO writes. The explicit POST below
// does the atomic consume.
export const prerender = false;

const token = Astro.url.searchParams.get('token') ?? '';
const forcedState = Astro.url.searchParams.get('state');

let state: 'valid' | 'expired' | 'invalid' | 'exists' = 'invalid';
let domain = '';
if (forcedState === 'exists') {
  state = 'exists';
} else if (forcedState !== 'invalid' && token) {
  const peek = await peekTrialToken({ store: d1TrialVerifyStore(env.DB) }, token);
  state = peek.state;
  if (peek.state === 'valid') domain = peek.domain;
}
const titles = {
  valid: 'Tunnex · Confirm your trial',
  expired: 'Tunnex · Trial link expired',
  invalid: 'Tunnex · Trial link not valid',
  exists: 'Tunnex · Trial already exists',
} as const;
---

<Base title={titles[state]} noindex>
  <section
    class="mx-auto flex min-h-[65vh] w-full max-w-6xl flex-col items-center justify-center px-4 py-20 sm:px-6"
  >
    <Card class="mx-auto flex w-full max-w-md flex-col items-center gap-5 p-8 text-center">
      <Logo variant="vertical" class="h-5" />
      {
        state === 'valid' && (
          <>
            <h1 class="font-sans font-semibold text-[20px] text-text tracking-tight break-words">
              Confirm your trial for{' '}
              <span class="text-text underline decoration-primary">{domain}</span>
            </h1>
            {launchMode === 'prelaunch' ? (
              <p class="font-sans font-normal text-[14px] leading-[1.6] text-text-muted">
                One click reserves the {TRIAL_LENGTH_ADJ} Enterprise trial for {domain}. Your
                license key arrives when the beta opens · the clock starts then, not today.
              </p>
            ) : (
              <p class="font-sans font-normal text-[14px] leading-[1.6] text-text-muted">
                One click starts the {TRIAL_LENGTH_ADJ} Enterprise trial for {domain}. Your license
                key goes straight to your inbox · the {TRIAL_LENGTH_NOUN} start when it’s issued.
              </p>
            )}
            <form method="post" action="/api/trial/verify" class="w-full mt-2">
              <input type="hidden" name="token" value={token} />
              <Button variant="primary" class="w-full">
                Confirm trial
              </Button>
            </form>
            <p class="font-mono font-medium text-[11.5px] text-text-muted">
              Didn’t request this? Just close this page · nothing happens without this confirmation.
            </p>
          </>
        )
      }
      {
        state === 'expired' && (
          <>
            <h1 class="font-sans font-semibold text-[20px] text-text tracking-tight">
              This link has expired
            </h1>
            <p class="font-sans font-normal text-[14px] leading-[1.6] text-text-muted">
              Trial links are valid for 30 minutes. Request a fresh one and confirm from your inbox
              · it takes under a minute.
            </p>
            <Button href="/trial/" variant="secondary" class="w-full mt-2">
              Request a new link
            </Button>
          </>
        )
      }
      {
        state === 'invalid' && (
          <>
            <h1 class="font-sans font-semibold text-[20px] text-text tracking-tight">
              This link isn’t valid anymore
            </h1>
            <p class="font-sans font-normal text-[14px] leading-[1.6] text-text-muted">
              If you just clicked Confirm, you’re all set · the approval email is on its way to your
              inbox. Otherwise this link was already used, expired, or mistyped · head back to the
              trial page for a fresh one.
            </p>
            <Button href="/trial/" variant="secondary" class="w-full mt-2">
              Back to the trial page
            </Button>
          </>
        )
      }
      {
        state === 'exists' && (
          <>
            <h1 class="font-sans font-semibold text-[20px] text-text tracking-tight">
              Your domain already has a trial
            </h1>
            <p class="font-sans font-normal text-[14px] leading-[1.6] text-text-muted">
              Your company already started a trial · they’re one per domain. Check with your team
              (it may even be you), or write to us and we’ll sort it out.
            </p>
            <Button
              href="mailto:sales@tunnex.io?subject=Tunnex%20trial%20for%20my%20domain"
              variant="secondary"
              class="w-full mt-2"
            >
              Write to sales@tunnex.io
            </Button>
          </>
        )
      }
    </Card>
  </section>
</Base>
