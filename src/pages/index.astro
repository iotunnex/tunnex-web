---
import Base from '../layouts/Base.astro';
import { launchMode } from '../config';
---

<Base title="Tunnex — Self-hosted Zero Trust VPN">
  <section class="mx-auto flex max-w-3xl flex-col gap-4 px-6 py-24">
    <h1 class="text-4xl font-bold tracking-tight">Tunnex</h1>
    <p class="text-lg text-zinc-600 dark:text-zinc-400">
      Self-hosted Zero Trust VPN. Your keys. Your servers. Your network.
    </p>
    <p class="text-sm text-zinc-500">
      Placeholder page (S0.1). Launch mode: <code data-testid="launch-mode">{launchMode}</code>
    </p>
  </section>
</Base>
