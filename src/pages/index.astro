---
import Base from '../layouts/Base.astro';
import AccessPlaneDiagram from '../components/AccessPlaneDiagram.astro';
import WithWithoutTunnex from '../components/WithWithoutTunnex.astro';
import DesktopClientSection from '../components/DesktopClientSection.astro';
import GlobalScaleMapSection from '../components/GlobalScaleMapSection.astro';
import FaqSection from '../components/FaqSection.astro';
import { launchMode } from '../config';

const isBeta = launchMode === 'beta';
---

<Base
  title="Tunnex — Self-hosted Zero Trust VPN for People, Workloads & AI Agents"
  description="WireGuard-fast private networking with SSO, Zero Trust policies, and MCP governance for people, workloads, and AI agents. Self-hosted on infrastructure you run."
>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: 'Tunnex',
      description:
        'Self-hosted Zero Trust VPN with SSO, Zero Trust policies, AI agent MCP governance, and multi-org management.',
      brand: { '@type': 'Brand', name: 'Tunnex' },
      applicationCategory: 'SecurityApplication',
      offers: [
        { '@type': 'Offer', name: 'Open', price: '0', priceCurrency: 'USD' },
        {
          '@type': 'Offer',
          name: 'Enterprise',
          priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'USD' },
        },
      ],
    })}
  />

  <!-- Section 1: Hero -->
  <section
    class="mx-auto max-w-[1560px] px-4 sm:px-6 py-10 md:px-12 md:py-[104px] overflow-hidden w-full"
  >
    <div
      class="t-rise grid items-center gap-10 md:grid-cols-[0.78fr_1.22fr] md:gap-[96px] min-w-0 w-full"
    >
      <!-- Left Column: Copy & CTAs -->
      <div class="flex flex-col gap-[22px] min-w-0 w-full">
        <!-- Status Pill -->
        <div>
          <div
            class="inline-flex items-center gap-2 rounded-full border border-[var(--tnx-line-4)] bg-white/[0.02] px-3 py-1"
          >
            <div class="t-dot size-1.5 rounded-full bg-[#B03A45]"></div>
            <span class="tnx-tag uppercase"
              >{isBeta ? 'BETA · DOWNLOADS OPEN' : 'LAUNCHING SOON · BETA'}</span
            >
          </div>
        </div>

        <!-- H1 & Sub-headline -->
        <div class="min-w-0 w-full">
          <h1 class="tnx-h1 text-pretty">Self-hosted Zero&nbsp;Trust VPN.</h1>
          <p class="tnx-h1-sub mt-1">
            Connect everything. <span class="text-[#EDEDEB]">Trust nothing.</span>
          </p>
        </div>

        <!-- One-command Install Row -->
        <div class="flex flex-col gap-2 max-w-xl min-w-0 w-full">
          <div
            class="font-mono text-[9px] font-semibold tracking-[0.18em] text-[#5E5E5B] uppercase"
          >
            ONE-COMMAND INSTALL
          </div>
          <div
            class="flex items-center justify-between rounded-[7px] border border-[#2E2E2E] bg-[#101010] px-3.5 py-3 min-w-0 w-full max-w-full"
          >
            <div
              class="flex items-center gap-2 font-mono text-[11.5px] sm:text-[13px] text-[#D6D6D2] overflow-x-auto min-w-0 flex-1 pr-1"
            >
              <span class="text-[#5E5E5B] shrink-0">$</span>
              <span class="whitespace-nowrap">curl -fsSL https://get.tunnex.io | sh</span>
            </div>
            <button
              id="hero-copy-btn"
              type="button"
              class="t-btn t-sec ml-2 shrink-0 rounded-[6px] px-2.5 py-1 font-mono text-[11px] text-[#C9C9C4] hover:text-white"
            >
              COPY
            </button>
          </div>
          <p class="tnx-body-xs text-[#858582]">
            Runs on any VPS with Docker and a public address.
            {
              isBeta ? (
                <>
                  Prefer to verify first?{' '}
                  <a href="/docs/quickstart/" class="font-semibold text-[#C9C9C4] hover:underline">
                    Download, check the SHA256, inspect, then run →
                  </a>
                </>
              ) : (
                <> The installer ships with the beta.</>
              )
            }
          </p>
        </div>

        <!-- CTAs -->
        <div class="t-cta flex items-center gap-3 pt-2 flex-wrap sm:flex-nowrap min-w-0 w-full">
          <a
            href={isBeta ? '/download' : '/trial'}
            class="t-btn t-prim rounded-[99px] px-[22px] py-[14px] text-[14px] font-semibold text-[#F7F5F5] text-center max-[480px]:w-full"
          >
            {isBeta ? 'Download' : 'Start 14-day trial'}
          </a>
          <a
            href="/docs"
            class="t-btn t-sec rounded-[99px] px-[22px] py-[14px] text-[14px] font-semibold text-[#EDEDEB] text-center max-[480px]:w-full"
          >
            Read the docs
          </a>
        </div>
      </div>

      <!-- Right Column: Access Plane Diagram -->
      <div class="min-w-0 w-full overflow-x-auto">
        <AccessPlaneDiagram />
      </div>
    </div>
  </section>

  <script is:inline>
    const copyBtn = document.getElementById('hero-copy-btn');
    copyBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText('curl -fsSL https://get.tunnex.io | sh');
      copyBtn.textContent = 'COPIED';
      setTimeout(() => {
        copyBtn.textContent = 'COPY';
      }, 1800);
    });
  </script>

  <WithWithoutTunnex />
  <DesktopClientSection />
  <FaqSection />
  <GlobalScaleMapSection />

  <!-- Section 11: Final Closing CTA -->
  <section class="t-rv border-t border-[var(--tnx-line-1)]">
    <div
      class="mx-auto flex max-w-[1180px] flex-col items-center gap-5 px-7 py-[88px] text-center max-[620px]:px-[18px]"
    >
      <h2
        class="font-semibold text-[clamp(28px,3.6vw,42px)] leading-[1.12] tracking-[-0.025em] text-[#F5F5F5]"
      >
        {isBeta ? 'Up and running in minutes.' : 'Be first in line.'}
      </h2>
      <p class="max-w-[56ch] font-normal text-[16px] leading-[1.65] text-[#A9A9A6]">
        {
          isBeta
            ? 'Install the server, authenticate with your identity provider, and connect your first device in minutes.'
            : 'Tunnex is launching soon. Request a trial now and your license key arrives when the beta opens.'
        }
      </p>
      <div class="t-cta flex items-center gap-3 flex-wrap justify-center pt-1">
        <a
          href={isBeta ? '/download' : '/trial'}
          class="t-btn t-prim rounded-[99px] px-[22px] py-[14px] text-[14px] font-semibold text-[#F7F5F5]"
        >
          {isBeta ? 'Download' : 'Start 14-day trial'}
        </a>
        <a
          href="/enterprise"
          class="t-btn t-sec rounded-[99px] px-[22px] py-[14px] text-[14px] font-semibold text-[#EDEDEB]"
        >
          Contact sales
        </a>
      </div>
    </div>
  </section>

  <!-- Smooth Scroll Reveal & Parallax Effect Script -->
  <script is:inline>
    const revealElems = document.querySelectorAll('section, .t-rv, .t-rise');

    revealElems.forEach((el) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(16px)';
      el.style.transition =
        'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
    );

    revealElems.forEach((el) => observer.observe(el));
  </script>
</Base>
