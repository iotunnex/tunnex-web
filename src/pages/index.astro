---
import Base from '../layouts/Base.astro';
import Card from '../components/ui/Card.astro';
import CodeSnippet from '../components/ui/CodeSnippet.astro';
import CtaPair from '../components/ui/CtaPair.astro';
import { launchMode } from '../config';

// Placeholder home page — real content lands in S1.2. This page exercises the
// S1.1 design system (hero, CTA pair, code snippet, cards) on all breakpoints.
---

<Base title="Tunnex — Self-hosted Zero Trust VPN">
  <section class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-20 sm:px-6 md:py-28">
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-5xl">
      Self-hosted Zero Trust VPN.
    </h1>
    <p class="max-w-2xl text-lg text-text-muted">Your keys. Your servers. Your network.</p>
    <CodeSnippet label="one-command install" class="max-w-xl">
      curl -fsSL https://get.tunnex.io | sh
    </CodeSnippet>
    <CtaPair
      primaryLabel={launchMode === 'beta' ? 'Download' : 'Start 14-day trial'}
      primaryHref={launchMode === 'beta' ? '/download' : '/trial'}
      secondaryLabel="Read the docs"
      secondaryHref="/docs"
    />
  </section>

  <section class="mx-auto grid max-w-6xl gap-4 px-4 pb-24 sm:grid-cols-2 sm:px-6 lg:grid-cols-3">
    <Card>
      <h2 class="text-base font-semibold">WireGuard data plane</h2>
      <p class="mt-2 text-sm text-text-muted">
        Modern crypto in the kernel path. Your traffic never touches our servers.
      </p>
      <a href="/security" class="mt-3 inline-block text-sm font-semibold text-link">
        Architecture →
      </a>
    </Card>
    <Card>
      <h2 class="text-base font-semibold">SSO built in</h2>
      <p class="mt-2 text-sm text-text-muted">
        Google and Microsoft sign-in with multi-tenant organizations.
      </p>
      <a href="/pricing" class="mt-3 inline-block text-sm font-semibold text-link">
        Enterprise →
      </a>
    </Card>
    <Card>
      <h2 class="text-base font-semibold">Fail-closed by design</h2>
      <p class="mt-2 text-sm text-text-muted">
        Desktop clients with a kill-switch designed to fail closed, not open.
      </p>
      <a href="/download" class="mt-3 inline-block text-sm font-semibold text-link"> Clients → </a>
    </Card>
  </section>
</Base>
