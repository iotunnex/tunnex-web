---
import { TRIAL_LENGTH_ADJ } from '../lib/issuance.ts';
import Base from '../layouts/Base.astro';
import TurnstileWidget from '../components/TurnstileWidget.astro';
import { launchMode } from '../config';

const isBeta = launchMode === 'beta';

const entFeatures = [
  'SSO with Google Workspace and Microsoft Entra ID',
  'IdP group sync: directory groups become policy subjects',
  'Zero Trust access policies: default-deny, port-scoped, per-user',
  'Time-boxed grants that expire on their own',
  'Device approval gate and posture checks',
  'Org-wide MFA enforcement',
  'Multi-org (multi-tenant) management',
  'Kubernetes operator, CRDs, and machine principals',
  'Priority support',
];
---

<Base
  title="Contact Sales: Tunnex Enterprise"
  description="Talk to Tunnex about Enterprise: seat pricing, procurement paperwork, air-gapped deployments, or a technical review of the architecture."
>
  <div
    class="mx-auto max-w-[1180px] px-7 py-18 md:py-[72px] flex flex-col gap-10 max-[620px]:px-[18px]"
  >
    <!-- Header -->
    <div class="flex flex-col gap-3.5 max-w-[66ch]">
      <div class="tnx-eyebrow">CONTACT SALES</div>
      <h1 class="tnx-h1">Talk to us about Enterprise</h1>
      <div class="font-normal text-[16px] leading-[1.68] text-[#A9A9A6] text-pretty">
        Seat pricing, procurement paperwork, air-gapped deployments, or a technical review of the
        architecture. Tell us what you need and a human replies: no sequence, no drip.
      </div>
    </div>

    <div class="t-g2 grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr] gap-3.5 items-start">
      <!-- Left Column: Form -->
      <div
        class="t-card border border-white/9 rounded-lg bg-[rgba(18,18,18,0.72)] p-6.5 flex flex-col gap-4"
      >
        <div id="lead-form-container">
          <!-- Dynamic client-side error alert -->
          <div
            id="form-error-alert"
            class="hidden border border-error/40 bg-error/15 rounded-md p-3.5 mb-4 items-center gap-3 transition-all"
          >
            <div class="size-2 rounded-full bg-error shrink-0"></div>
            <div id="form-error-text" class="font-normal text-[12.5px] leading-[1.5] text-text">
              Lead request failed. Please check your form input.
            </div>
          </div>
          {
            !isBeta && (
              <div class="border border-[#C9989C]/30 bg-[#B03A45]/12 rounded-md p-3.5 mb-4 flex items-center gap-3">
                <div class="size-2 rounded-full bg-[#B03A45] shrink-0 animate-pulse" />
                <div class="font-normal text-[12.5px] leading-[1.5] text-[#EDEDEB]">
                  <strong class="font-semibold text-[#F5F5F5]">PRELAUNCH · COMING SOON:</strong> We
                  are currently building Tunnex! Submit your details to request enterprise access
                  for the upcoming Public Beta.
                </div>
              </div>
            )
          }
          <form
            id="lead-form"
            action="/api/enterprise-lead"
            method="POST"
            class="flex flex-col gap-4"
          >
            <div class="t-g2 grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="flex flex-col gap-1.75">
                <label
                  for="tnxName"
                  class="font-mono font-semibold text-[9px] tracking-[0.16em] text-[#5E5E5B] uppercase"
                  >NAME</label
                >
                <input
                  id="tnxName"
                  name="name"
                  type="text"
                  required
                  placeholder="Jane Okafor"
                  class="bg-[#121212] border border-[#2E2E2E] rounded-md px-3.25 py-3 font-normal text-[14px] text-[#EDEDEB] shadow-[inset_0_1px_3px_rgba(0,0,0,0.22)] focus:outline-none"
                />
              </div>
              <div class="flex flex-col gap-1.75">
                <label
                  for="tnxCo"
                  class="font-mono font-semibold text-[9px] tracking-[0.16em] text-[#5E5E5B] uppercase"
                  >COMPANY</label
                >
                <input
                  id="tnxCo"
                  name="company"
                  type="text"
                  required
                  placeholder="Acme"
                  class="bg-[#121212] border border-[#2E2E2E] rounded-md px-3.25 py-3 font-normal text-[14px] text-[#EDEDEB] shadow-[inset_0_1px_3px_rgba(0,0,0,0.22)] focus:outline-none"
                />
              </div>
              <div class="flex flex-col gap-1.75">
                <label
                  for="tnxMail"
                  class="font-mono font-semibold text-[9px] tracking-[0.16em] text-[#5E5E5B] uppercase"
                  >WORK EMAIL</label
                >
                <input
                  id="tnxMail"
                  name="email"
                  type="email"
                  required
                  placeholder="jane@acme.com"
                  class="bg-[#121212] border border-[#2E2E2E] rounded-md px-3.25 py-3 font-normal text-[14px] text-[#EDEDEB] shadow-[inset_0_1px_3px_rgba(0,0,0,0.22)] focus:outline-none"
                />
              </div>
              <div class="flex flex-col gap-1.75">
                <label
                  for="tnxSeats"
                  class="font-mono font-semibold text-[9px] tracking-[0.16em] text-[#5E5E5B] uppercase"
                  >SEATS</label
                >
                <input
                  id="tnxSeats"
                  name="seats"
                  type="text"
                  placeholder="120"
                  class="bg-[#121212] border border-[#2E2E2E] rounded-md px-3.25 py-3 font-normal text-[14px] text-[#EDEDEB] shadow-[inset_0_1px_3px_rgba(0,0,0,0.22)] focus:outline-none"
                />
              </div>
            </div>

            <div class="flex flex-col gap-1.75">
              <label
                for="tnxMsg"
                class="font-mono font-semibold text-[9px] tracking-[0.16em] text-[#5E5E5B] uppercase"
                >MESSAGE</label
              >
              <textarea
                id="tnxMsg"
                name="message"
                rows="4"
                placeholder="What are you trying to solve?"
                class="bg-[#121212] border border-[#2E2E2E] rounded-md px-3.25 py-3 font-normal text-[14px] leading-[1.6] text-[#EDEDEB] shadow-[inset_0_1px_3px_rgba(0,0,0,0.22)] resize-y focus:outline-none"
              ></textarea>
            </div>

            <TurnstileWidget />

            <button
              id="lead-submit-btn"
              type="submit"
              class="t-btn t-prim w-full text-center rounded-[9px] px-5 py-3.5 font-semibold text-[14px] cursor-pointer"
            >
              Send to sales
            </button>
          </form>
        </div>

        <div id="lead-sent-box" class="hidden flex flex-col gap-2.75">
          <div class="flex items-center gap-2.5">
            <span class="lic size-4.5 shrink-0 text-[#6E9C7C]">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-full"
                ><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"
                ></path></svg
              >
            </span>
            <div class="font-semibold text-[16px] text-[#F5F5F5]">
              Thanks — that reached sales@tunnex.io
            </div>
          </div>
          <div class="font-normal text-[14px] leading-[1.66] text-[#858582]">
            We reply within one business day. If it is urgent, mail sales@tunnex.io directly and
            reference your company name.
          </div>
          <button
            id="lead-reset-btn"
            type="button"
            class="t-btn t-sec self-start rounded-[9px] px-4.5 py-2.75 font-semibold text-[13px] cursor-pointer mt-1"
          >
            Send another
          </button>
        </div>
      </div>

      <!-- Right Column: Enterprise Features & Trial Box -->
      <div class="flex flex-col gap-3.5">
        <div
          class="bg-[rgba(18,18,18,0.72)] border border-white/[0.09] rounded-lg p-5 flex flex-col gap-2.75"
        >
          <div
            class="font-mono font-semibold text-[9px] tracking-[0.16em] text-[#5E5E5B] uppercase mb-1"
          >
            WHAT ENTERPRISE ADDS
          </div>
          {
            entFeatures.map((f) => (
              <div class="flex items-start gap-2.5">
                <span class="lic size-3.75 shrink-0 text-[#6E9C7C] mt-0.5">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-full"
                  >
                    <>
                      <path d="M21.801 10A10 10 0 1 1 17 3.335" />
                      <path d="m9 11 3 3L22 4" />
                    </>
                  </svg>
                </span>
                <span class="font-normal text-[13.5px] leading-[1.55] text-[#A9A9A6]">{f}</span>
              </div>
            ))
          }
        </div>

        <div
          class="bg-[rgba(18,18,18,0.72)] border border-white/[0.09] rounded-lg p-5 flex flex-col gap-2"
        >
          <div class="font-semibold text-[13.5px] text-[#EDEDEB]">Rather try it first?</div>
          <div class="font-normal text-[13px] leading-[1.6] text-[#858582]">
            The {TRIAL_LENGTH_ADJ} trial needs no card and no call.
          </div>
          <a
            href="/trial"
            class="t-btn t-sec self-start rounded-[9px] px-4.5 py-2.75 font-semibold text-[13px] mt-1"
          >
            Start {TRIAL_LENGTH_ADJ} trial
          </a>
        </div>
      </div>
    </div>
  </div>
</Base>

<script is:inline>
  const form = document.getElementById('lead-form');
  const formBox = document.getElementById('lead-form-container');
  const sentBox = document.getElementById('lead-sent-box');
  const resetBtn = document.getElementById('lead-reset-btn');
  const submitBtn = document.getElementById('lead-submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    if (!formData.get('cf-turnstile-response')) {
      const token = document.querySelector('[name="cf-turnstile-response"]')?.value;
      if (token) formData.set('cf-turnstile-response', token);
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }

    try {
      const res = await fetch('/api/enterprise-lead', {
        method: 'POST',
        body: formData,
      });

      if (res.redirected) {
        window.location.href = res.url;
        return;
      }

      if (res.ok && formBox && sentBox) {
        formBox.classList.add('hidden');
        sentBox.classList.remove('hidden');
      } else {
        const data = await res.json().catch(() => ({}));
        const errAlert = document.getElementById('form-error-alert');
        const errText = document.getElementById('form-error-text');
        if (errAlert && errText) {
          errText.textContent =
            data.message || 'Lead request failed. Please check your form input.';
          errAlert.classList.remove('hidden');
          errAlert.classList.add('flex');
          errAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    } catch (err) {
      console.error(err);
      if (formBox && sentBox) {
        formBox.classList.add('hidden');
        sentBox.classList.remove('hidden');
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send to sales';
      }
    }
  });

  resetBtn?.addEventListener('click', () => {
    if (formBox && sentBox) {
      sentBox.classList.add('hidden');
      formBox.classList.remove('hidden');
    }
  });
</script>
