exports[`email templates > renders enterprise-lead-ack (html + text snapshot) 1`] = `
{
  "html": "<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>We received your Tunnex Enterprise inquiry</title>
</head>
<body style="margin:0;padding:0;background-color:#0A0A0A;color:#EDEDEB;">

<div style="max-width:560px;margin:0 auto;padding:40px 20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <div style="background-color:#141414;border:1px solid #2E2E2E;border-radius:12px;padding:32px 28px;color:#EDEDEB;font-size:15px;line-height:1.6;">
    <div style="padding-bottom:24px;margin-bottom:24px;border-bottom:1px solid #2E2E2E;text-align:center;">
      <a href="https://example.test" style="text-decoration:none;display:inline-block;">
        <img src="https://example.test/email/tunnex-logo-2x.png" alt="Tunnex" width="176" height="22" style="display:block;border:0;margin:0 auto;outline:none;">
      </a>
    </div>
<p style="margin:0 0 16px;color:#EDEDEB;font-size:15px;line-height:1.6;">Hi Ada Lovelace,</p><p style="margin:0 0 16px;color:#EDEDEB;font-size:15px;line-height:1.6;">Thank you for reaching out about Tunnex Enterprise for <strong>Acme Corp</strong>. We received your request and our enterprise team is reviewing your details.</p><p style="margin:0 0 16px;color:#EDEDEB;font-size:15px;line-height:1.6;">We’ll get back to you shortly with tailored deployment guidance, pricing, and next steps for your architecture.</p><p style="margin:0 0 16px;color:#EDEDEB;font-size:15px;line-height:1.6;">In the meantime, feel free to explore our <a href="https://example.test/docs/" style="color:#EDEDEB;text-decoration:underline;">documentation</a> or reply directly to this email if you have any questions.</p>
  </div>
  <p style="color:#A9A9A6;font-size:12px;line-height:1.6;padding-top:20px;margin:0;text-align:center;">
    Tunnex · Connect everything. Trust nothing.<br>
    Questions? Reply to this email or write to <a href="mailto:support@tunnex.io" style="color:#A9A9A6;text-decoration:underline;">support@tunnex.io</a>.
  </p>
</div>
<!-- tnx:test-nonce -->
</body>
</html>",
  "subject": "We received your Tunnex Enterprise inquiry",
  "text": "Hi Ada Lovelace,

Thank you for reaching out about Tunnex Enterprise for Acme Corp. We received your request and our enterprise team is reviewing your details.

We’ll get back to you shortly with tailored deployment guidance, pricing, and next steps for your architecture.

Documentation: https://example.test/docs/",
}
`;

