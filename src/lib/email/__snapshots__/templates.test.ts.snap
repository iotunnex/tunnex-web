  <div style="background-color:#141414;border:1px solid #2E2E2E;border-radius:12px;padding:32px 28px;color:#EDEDEB;font-size:15px;line-height:1.6;">
    <div style="padding-bottom:24px;margin-bottom:24px;border-bottom:1px solid #2E2E2E;text-align:center;">
