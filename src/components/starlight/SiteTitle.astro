---
// Starlight SiteTitle override: the tokenized brand lockup instead of the
// text wordmark (kept inline so the semantic tokens resolve — an <img> logo
// cannot use CSS variables).
import Logo from '../Logo.astro';
---

<a href="/docs/" class="site-title-logo" aria-label="Tunnex documentation home">
  <Logo class="logo-lockup" />
  <span class="docs-tag">Docs</span>
</a>

<style>
  .site-title-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--sl-color-text);
  }
  .site-title-logo :global(.logo-lockup) {
    height: 1.375rem;
    width: auto;
  }
  .docs-tag {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-text-accent);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    padding: 0 0.4rem;
    line-height: 1.4;
  }
</style>
