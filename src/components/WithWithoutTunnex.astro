---
// With / Without Tunnex Comparison Section (Section 2)
---

<section
  class="t-rv border-t border-[var(--tnx-line-1)] bg-[var(--tnx-band)]"
  id="with-without-tunnex"
>
  <div
    class="mx-auto max-w-[1180px] px-7 py-20 md:py-[88px] flex flex-col gap-6 max-[620px]:px-[18px]"
  >
    <!-- Header with ON / OFF Toggle & Explainer -->
    <div class="flex flex-col items-center gap-[18px] text-center">
      <div class="flex items-center gap-[14px] flex-wrap justify-center">
        <!-- Segmented Toggle -->
        <div
          class="flex items-center gap-[3px] border border-[#262626] rounded-[9px] p-[3px] bg-[rgba(18,18,18,0.72)]"
        >
          <button
            id="tnx-toggle-on"
            type="button"
            class="t-btn rounded-[6px] px-3.5 py-1.5 font-mono text-[11px] font-bold tracking-wider uppercase transition-all duration-200 text-[#F5F5F5] bg-gradient-to-r from-[#B03A45] to-[#6E1520]"
          >
            ON
          </button>
          <button
            id="tnx-toggle-off"
            type="button"
            class="t-btn rounded-[6px] px-3.5 py-1.5 font-mono text-[11px] font-bold tracking-wider uppercase transition-all duration-200 text-[#5E5E5B] bg-transparent hover:text-white"
          >
            OFF
          </button>
        </div>

        <!-- Official TUNNEX Wordmark SVG -->
        <img
          src="/assets/tunnex-wordmark.svg"
          id="tnx-toggle-wordmark"
          alt="TUNNEX"
          class="h-[15px] w-auto block transition-opacity duration-300 opacity-100"
        />
      </div>

      <!-- Explainer Copy -->
      <div
        id="tnx-toggle-explainer"
        class="font-sans text-[16px] md:text-[20px] leading-[1.6] text-[#A9A9A6] max-w-[60ch] text-pretty transition-all duration-300"
      >
        Tunnex compiles your policy into WireGuard peers and gateway state, so people, sites and
        services connect directly. The control plane hands out config and never carries a packet.
      </div>
    </div>

    <!-- Diagram Canvas Container -->
    <div class="w-full">
      <!-- WITH TUNNEX SVG DIAGRAM (Default Visible) -->
      <div id="tnx-diagram-on" class="t-diag block w-full">
        <svg
          viewBox="0 0 1000 560"
          role="img"
          aria-labelledby="tnxOnTitle tnxOnDesc"
          class="w-full h-auto block select-none"
        >
          <title id="tnxOnTitle">
            With Tunnex: direct encrypted tunnels between people, sites and services
          </title>
          <desc id="tnxOnDesc">
            Two locations on the left — an office and a home — connect over peer-to-peer WireGuard
            tunnels straight to a cloud environment and a datacenter on the right. A site-to-site
            tunnel links the cloud and the datacenter. The self-hosted Tunnex control plane in the
            middle distributes configuration and policy to all four over dotted lines, and never
            carries traffic.
          </desc>

          <!-- Animated Peer-to-Peer Tunnels -->
          <g fill="none" stroke="#C9C9C4" stroke-width="1.8" stroke-linecap="round">
            <path class="t-edge" d="M260 135 H740"></path>
            <path class="t-edge" d="M260 425 H740"></path>
            <path class="t-edge" d="M860 210 V350"></path>
          </g>

          <!-- Dotted Config & Policy Links -->
          <g fill="none" stroke="#454542" stroke-width="1.2" stroke-dasharray="4 7">
            <path d="M160 210 V280 H380"></path>
            <path d="M160 350 V280 H380"></path>
            <path d="M790 210 V280 H620"></path>
            <path d="M790 350 V280 H620"></path>
          </g>

          <!-- Diagram Edge Text -->
          <g font-family="var(--tnx-sans)" font-size="13.5" fill="#858582" text-anchor="middle">
            <text x="500" y="106">peer-to-peer</text>
            <text x="500" y="123">WireGuard® tunnel</text>
            <text x="500" y="452">peer-to-peer</text>
            <text x="500" y="469">WireGuard® tunnel</text>
            <text x="500" y="205">config &amp; policy</text>
          </g>
          <g font-family="var(--tnx-sans)" font-size="13.5" fill="#858582">
            <text x="878" y="275">site-to-site</text>
            <text x="878" y="292">WireGuard® tunnel</text>
