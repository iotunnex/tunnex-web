        </div>
        <div
          id="tnx-card-body-3"
          class="font-normal text-[13px] leading-[1.6] text-[#858582] text-pretty"
        >
          The control plane distributes config and policy. Traffic goes peer to peer; if the plane
          is down, existing tunnels keep running.
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const btnOn = document.getElementById('tnx-toggle-on');
  const btnOff = document.getElementById('tnx-toggle-off');
  const wordmark = document.getElementById('tnx-toggle-wordmark');
  const explainer = document.getElementById('tnx-toggle-explainer');
  const diagOn = document.getElementById('tnx-diagram-on');
  const diagOff = document.getElementById('tnx-diagram-off');

  const cardTitle1 = document.getElementById('tnx-card-title-1');
  const cardBody1 = document.getElementById('tnx-card-body-1');
  const cardTitle2 = document.getElementById('tnx-card-title-2');
  const cardBody2 = document.getElementById('tnx-card-body-2');
  const cardTitle3 = document.getElementById('tnx-card-title-3');
  const cardBody3 = document.getElementById('tnx-card-body-3');

  const onData = {
    explainer:
      'Tunnex compiles policy into WireGuard peers and gateway state for direct connectivity. Control planes distribute config without touching traffic.',
    cards: [
      {
        title: 'One command per host',
        body: 'Gateways enroll automatically and pull configuration. No manual keys or per-site firewall edits.',
      },
      {
        title: 'Policy compiles to the wire',
        body: 'Rules become deterministic peer allow-lists and kernel nftables state. Default-deny by design.',
      },
      {
        title: 'Zero single points of failure',
        body: 'Peer to peer data paths stay active even during control plane maintenance or network outages.',
      },
    ],
  };

  const offData = {
    explainer:
      'Traditional VPNs require manual wiring for certificates, address pools, NAT, DNS, and per-site gateways.',
    cards: [
      {
        title: 'Every path is hand-built',
        body: 'Certificates, IP plans, NAT, and DNS drift apart as configurations change over time.',
      },
      {
        title: 'Centralized gateway bottleneck',
        body: 'All traffic funnels through single appliances. Gateway failure brings down entire sites.',
      },
      {
        title: 'Fragmented access control',
        body: 'Policy is scattered across security groups and route tables without unified audit trails.',
      },
    ],
  };

  function setOnOff(isOn) {
    if (isOn) {
      btnOn.className =
        't-btn rounded-[6px] px-3.5 py-1.5 font-mono text-[11px] font-bold tracking-wider uppercase transition-all duration-200 text-[#F5F5F5] bg-gradient-to-r from-[#B03A45] to-[#6E1520]';
      btnOff.className =
        't-btn rounded-[6px] px-3.5 py-1.5 font-mono text-[11px] font-bold tracking-wider uppercase transition-all duration-200 text-[#5E5E5B] bg-transparent hover:text-white';
      wordmark.style.opacity = '1';
      explainer.textContent = onData.explainer;
      diagOn.classList.remove('hidden');
      diagOn.classList.add('block');
      diagOff.classList.remove('block');
      diagOff.classList.add('hidden');

      cardTitle1.textContent = onData.cards[0].title;
      cardBody1.textContent = onData.cards[0].body;
      cardTitle2.textContent = onData.cards[1].title;
      cardBody2.textContent = onData.cards[1].body;
      cardTitle3.textContent = onData.cards[2].title;
      cardBody3.textContent = onData.cards[2].body;
    } else {
      btnOff.className =
        't-btn rounded-[6px] px-3.5 py-1.5 font-mono text-[11px] font-bold tracking-wider uppercase transition-all duration-200 text-[#F5F5F5] bg-gradient-to-r from-[#B03A45] to-[#6E1520]';
      btnOn.className =
        't-btn rounded-[6px] px-3.5 py-1.5 font-mono text-[11px] font-bold tracking-wider uppercase transition-all duration-200 text-[#5E5E5B] bg-transparent hover:text-white';
      wordmark.style.opacity = '0.4';
      explainer.textContent = offData.explainer;
      diagOff.classList.remove('hidden');
      diagOff.classList.add('block');
      diagOn.classList.remove('block');
      diagOn.classList.add('hidden');

      cardTitle1.textContent = offData.cards[0].title;
      cardBody1.textContent = offData.cards[0].body;
      cardTitle2.textContent = offData.cards[1].title;
      cardBody2.textContent = offData.cards[1].body;
      cardTitle3.textContent = offData.cards[2].title;
      cardBody3.textContent = offData.cards[2].body;
    }
  }

  btnOn?.addEventListener('click', () => setOnOff(true));
  btnOff?.addEventListener('click', () => setOnOff(false));
</script>
