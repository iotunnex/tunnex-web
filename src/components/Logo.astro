---
import logoSvg from '../assets/tunnex-logo.svg?raw';
import wordmarkSvg from '../assets/tunnex-wordmark.svg?raw';
import wordmarkLightSvg from '../assets/tunnex-wordmark-light.svg?raw';

interface Props {
  variant?: 'lockup' | 'wordmark' | 'badge' | 'vertical';
  class?: string;
}

const { variant = 'lockup', class: className = 'h-6' } = Astro.props;

const logoHtml = logoSvg.replace('<svg ', `<svg class="size-full object-contain" `);
const wordmarkDark = wordmarkSvg.replace('<svg ', `<svg class="logo-variant-dark ${className}" `);
const wordmarkLight = wordmarkLightSvg.replace(
  '<svg ',
  `<svg class="logo-variant-light ${className}" `,
);
---

{
  variant === 'vertical' ? (
    <span
      class={`inline-flex flex-col items-center gap-4 ${className.replace(/h-\S+/, '')}`.trim()}
    >
      <span class="inline-flex size-16 items-center justify-center bg-transparent p-1 overflow-hidden">
        <Fragment set:html={logoHtml} />
      </span>
      <Fragment set:html={wordmarkDark + wordmarkLight} />
    </span>
  ) : variant === 'wordmark' ? (
    <Fragment set:html={wordmarkDark + wordmarkLight} />
  ) : (
    <span class={`inline-flex items-center gap-3 ${className.replace(/h-\S+/, '')}`.trim()}>
      <span class="inline-flex size-7 items-center justify-center bg-transparent p-0 overflow-hidden flex-none">
        <Fragment set:html={logoHtml} />
      </span>
      <Fragment set:html={wordmarkDark + wordmarkLight} />
    </span>
  )
}

<style is:global>
  .logo-variant-dark {
    display: block;
  }
  .dark .logo-variant-dark,
  [data-theme='dark'] .logo-variant-dark {
    display: none;
  }
  .logo-variant-light {
    display: none;
  }
  .dark .logo-variant-light,
  [data-theme='dark'] .logo-variant-light {
    display: block;
  }
</style>
