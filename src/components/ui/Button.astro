---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'submit' | 'button';
  class?: string;
}

const { href, variant = 'primary', type = 'submit', class: className = '' } = Astro.props;

const base =
  't-btn inline-flex min-h-11 items-center justify-center rounded-[9px] px-5 py-3 text-sm font-semibold transition-all cursor-pointer ' +
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
const variants = {
  primary: 't-prim text-text',
  secondary: 't-sec text-text',
};
const classes = `${base} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
