---
// Why Tunnex 4-Cell Differentiators Section (Section 5)
const diffs = [
  { n: '01', title: 'Fully self-hosted. Zero SaaS in the trust path.', body: 'Control plane, gateways and clients all run on infrastructure you own, and the deployment is air-gappable.' },
  { n: '02', title: 'Both protocols, both governed.', body: 'Both protocols sit under one policy engine. An OpenVPN device is a subject in the same compiled artifact, not a second door.' },
  { n: '03', title: 'Zero Trust depth, self-hosted.', body: 'Per-user and expiring grants, IdP group sync, device posture, kernel-stamped flow logs, Kubernetes-native exposure.' },
  { n: '04', title: 'Proven on a live wire.', body: 'Capabilities ship after they are demonstrated end to end. Cross-cloud site-to-site: 138ms, Sydney to West US.' }
];
---

<section class="t-rv border-t border-[var(--tnx-line-1)]" id="why-tunnex-section">
  <div class="mx-auto max-w-[1180px] px-7 py-22 md:py-[88px] max-[620px]:px-[18px]">
    <!-- 2-Column Header -->
    <div class="t-g2 grid grid-cols-1 md:grid-cols-2 gap-[48px] items-start mb-12">
      <div class="flex flex-col gap-3">
        <div class="tnx-eyebrow">WHY TUNNEX</div>
        <h2 class="tnx-h2 max-w-[20ch]">Four things that are hard to get anywhere else.</h2>
      </div>
      <div class="font-normal text-[16px] leading-[1.68] text-[#A9A9A6] text-pretty pt-2">
        Plenty of products do one of these. The combination is the reason Tunnex exists.
      </div>
    </div>

    <!-- 4-Cell Clean Minimal Grid -->
    <div class="t-rise grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
      {
        diffs.map((d) => (
          <div class="border-t border-white/10 pt-5 flex gap-4 items-start group">
            <div class="font-mono font-semibold text-[15px] leading-none text-[#5E5E5B] group-hover:text-[#EDEDEB] transition-colors shrink-0 pt-0.5">
              {d.n}
            </div>
            <div class="flex flex-col gap-2">
              <div class="font-semibold text-[15.5px] leading-[1.3] text-[#EDEDEB] tracking-[-0.01em]">
                {d.title}
              </div>
              <div class="font-normal text-[13.5px] leading-[1.6] text-[#858582] text-pretty">
                {d.body}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Bottom Link -->
    <a
      href="/features"
      class="inline-flex items-center gap-2 mt-10 font-semibold text-[13.5px] text-[#C9C9C4] hover:text-white transition-colors"
    >
      <span>See the full capability inventory</span>
      <span class="font-mono font-semibold text-[13px]">→</span>
    </a>
  </div>
</section>
