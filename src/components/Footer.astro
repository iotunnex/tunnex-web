---
import { launchMode } from '../config';

const year = new Date().getFullYear();
const showGitHub = launchMode === 'beta';
---

<footer class="mt-auto border-t border-border">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 sm:px-6 md:grid-cols-4">
    <div class="sm:col-span-2 md:col-span-1">
      <p class="font-mono text-base font-bold text-text">
        tunnex<span class="text-primary">.</span>
      </p>
      <p class="mt-2 max-w-xs text-sm text-text-muted">
        Self-hosted Zero Trust VPN. Your keys. Your servers. Your network.
      </p>
    </div>

    <nav aria-label="Product">
      <p class="text-xs font-semibold tracking-wide text-text-muted uppercase">Product</p>
      <ul class="mt-3 flex flex-col gap-2 text-sm">
        <li><a href="/pricing" class="text-text-muted hover:text-text">Pricing</a></li>
        <li><a href="/download" class="text-text-muted hover:text-text">Download</a></li>
        <li><a href="/security" class="text-text-muted hover:text-text">Security</a></li>
        <li><a href="/docs" class="text-text-muted hover:text-text">Documentation</a></li>
        {
          showGitHub && (
            <li>
              <a href="https://github.com/iotunnex" class="text-text-muted hover:text-text">
                GitHub
              </a>
            </li>
          )
        }
      </ul>
    </nav>

    <nav aria-label="Contact">
      <p class="text-xs font-semibold tracking-wide text-text-muted uppercase">Contact</p>
      <ul class="mt-3 flex flex-col gap-2 text-sm">
        <li>
          <a href="mailto:sales@tunnex.io" class="text-text-muted hover:text-text">
            sales@tunnex.io
          </a>
        </li>
        <li>
          <a href="mailto:security@tunnex.io" class="text-text-muted hover:text-text">
            security@tunnex.io
          </a>
        </li>
      </ul>
    </nav>

    <nav aria-label="Legal">
      <p class="text-xs font-semibold tracking-wide text-text-muted uppercase">Legal</p>
      <ul class="mt-3 flex flex-col gap-2 text-sm">
        {/* Privacy/terms pages land in S4.3 — slots wired now. */}
        <li><a href="/privacy" class="text-text-muted hover:text-text">Privacy</a></li>
        <li><a href="/terms" class="text-text-muted hover:text-text">Terms</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-border">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-text-muted sm:px-6">
      © {year} Tunnex. All rights reserved.
    </p>
  </div>
</footer>
