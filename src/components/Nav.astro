---
import { TRIAL_LENGTH_ADJ } from '../lib/issuance.ts';
import { launchMode } from '../config';
import Logo from './Logo.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/download', label: 'Download' },
  { href: '/security', label: 'Security' },
  { href: '/blog', label: 'Blog' },
  { href: '/docs', label: 'Docs' },
];

const isBeta = launchMode === 'beta';

// Active-nav: current path segment check
const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<header
  class="relative sticky top-0 z-[60] h-[64px] w-full border-b border-[var(--tnx-line-2)] bg-[var(--tnx-topbar)] backdrop-blur-[24px] backdrop-saturate-[140%]"
>
  <nav
    aria-label="Main"
    class="mx-auto flex h-full max-w-[1180px] items-center justify-between gap-[22px] px-[28px] max-[620px]:px-[18px]"
  >
    <!-- Brand / Logo -->
    <a
      href="/"
      aria-label="Tunnex — Home"
      class="inline-flex items-center group focus-visible:outline-none"
    >
      <Logo variant="lockup" class="h-4 w-auto" />
    </a>

    <!-- Desktop Navigation Links (Hidden under 960px) -->
    <ul class="t-navlinks flex items-center gap-1 max-[960px]:hidden">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                't-nav inline-block rounded-[9px] px-[12px] py-[7px] text-[13.5px] font-medium leading-none text-[#C9C9C4] transition-colors',
                isActive(l.href)
                  ? 'bg-white/[0.06] text-[#EDEDEB]'
                  : 'hover:bg-white/[0.06] hover:text-[#EDEDEA]',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Right Controls / CTA -->
    <div class="flex items-center gap-3">
      <!-- Mode Badge / Segmented Chip (Desktop) -->
      <div
        class="hidden items-center rounded-[9px] border border-[#262626] bg-[rgba(18,18,18,0.72)] px-2.5 py-1 text-[10.5px] font-mono font-semibold uppercase tracking-wider text-[#858582] md:flex"
      >
        <span>{isBeta ? 'BETA' : 'PRELAUNCH'}</span>
      </div>

      <!-- Primary CTA Button -->
      <a
        href={isBeta ? '/download' : '/trial'}
        class="t-btn t-prim hidden rounded-[9px] px-4 py-[9px] text-[14px] font-semibold leading-none text-[#F7F5F5] min-[960px]:inline-flex items-center justify-center"
      >
        {isBeta ? 'Download' : `Start ${TRIAL_LENGTH_ADJ} trial`}
      </a>

      <!-- Mobile Burger Button (Shown under 960px) -->
      <button
        id="nav-menu-btn"
        type="button"
        class="t-btn t-sec t-burger hidden size-[38px] items-center justify-center rounded-[9px] text-[#C9C9C4] hover:text-white max-[960px]:inline-flex"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <svg
          class="size-[17px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown Panel -->
  <div
    id="nav-menu"
    class="hidden fixed inset-x-0 top-[64px] h-[calc(100dvh-64px)] border-b border-[#2E2E2E] bg-[#0E0E0E] px-6 py-6 shadow-[0_30px_60px_rgba(0,0,0,0.95)] backdrop-blur-2xl z-[100] overflow-y-auto flex flex-col justify-between"
  >
    <ul class="flex flex-col gap-2">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'block rounded-[10px] px-4 py-3.5 text-[17px] font-medium text-[#C9C9C4] hover:bg-white/[0.06] hover:text-white transition-colors',
                isActive(l.href) ? 'bg-white/[0.08] text-white font-semibold' : '',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-8 pt-5 border-t border-white/10 flex flex-col gap-3 pb-8">
      <a
        href={isBeta ? '/download' : '/trial'}
        class="t-btn t-prim block w-full rounded-[10px] py-4 text-center text-[15px] font-semibold text-[#F7F5F5] shadow-lg"
      >
        {isBeta ? 'Download' : `Start ${TRIAL_LENGTH_ADJ} trial`}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('nav-menu-btn');
  const menu = document.getElementById('nav-menu');

  if (btn && menu) {
    const toggleMenu = (open?: boolean) => {
      const isHidden = menu.classList.contains('hidden');
      const shouldOpen = open !== undefined ? open : isHidden;
      if (shouldOpen) {
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', 'Close menu');
        document.body.style.overflow = 'hidden';
      } else {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open menu');
        document.body.style.overflow = '';
      }
    };

    btn.addEventListener('click', () => toggleMenu());

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => toggleMenu(false));
    });
  }
</script>
