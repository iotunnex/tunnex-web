---
// Desktop Client Simulator Section (Section 3)
---

<section class="t-rv border-t border-[var(--tnx-line-1)]" id="desktop-client-section">
  <div class="mx-auto max-w-[1180px] px-7 py-22 md:py-[88px] max-[620px]:px-[18px]">
    <div class="t-g2 grid grid-cols-1 md:grid-cols-[452px_1fr] gap-[56px] items-start">
      <!-- Left Column: Interactive App Window Mock -->
      <div
        class="w-full max-w-[452px] min-h-[588px] flex flex-col overflow-hidden rounded-xl border border-white/10 bg-[#121212] mx-auto md:mx-0 shadow-[0_20px_50px_rgba(0,0,0,0.6)]"
      >
        <!-- Chrome Top Bar -->
        <div class="flex flex-col gap-3 p-[14px_16px_0] border-b border-white/[0.09]">
          <div class="flex items-center gap-1.5">
            <span class="size-[11px] rounded-full bg-[#E5544B]"></span>
            <span class="size-[11px] rounded-full bg-[#E0A83B]"></span>
            <span class="size-[11px] rounded-full bg-[#4A4A48]"></span>
          </div>

          <div class="flex flex-col gap-1">
            <svg viewBox="0 0 792 120" class="h-[19px] w-[124px] block" aria-label="TUNNEX">
              <path d="M34.944 116V27.392H1.67638e-08V6.79999H95.16V27.392H60.216V116H34.944ZM178.8 117.872C163.304 117.872 151.188 113.556 142.452 104.924C133.716 96.292 129.348 83.968 129.348 67.952V6.79999H154.62V67.016C154.62 77.416 156.752 84.904 161.016 89.48C165.28 94.056 171.26 96.344 178.956 96.344C186.652 96.344 192.632 94.056 196.896 89.48C201.16 84.904 203.292 77.416 203.292 67.016V6.79999H228.252V67.952C228.252 83.968 223.884 96.292 215.148 104.924C206.412 113.556 194.296 117.872 178.8 117.872ZM276.58 116V6.79999H297.484L361.912 85.424H351.772V6.79999H376.732V116H355.984L291.4 37.376H301.54V116H276.58ZM425.922 116V6.79999H446.826L511.254 85.424H501.114V6.79999H526.074V116H505.326L440.742 37.376H450.882V116H425.922Z" fill="#F5F5F5"></path>
              <path d="M564.547 0H665.749L655.37 28.5443H554.167L564.547 0Z" fill="url(#tnxWmClientA)"></path>
              <path d="M561.952 45.4114H657.965L650.18 73.9557H554.167L561.952 45.4114Z" fill="url(#tnxWmClientA)"></path>
              <path d="M559.357 90.8228H655.37L644.99 119.367H554.167L559.357 90.8228Z" fill="url(#tnxWmClientA)"></path>
              <path d="M680.635 116L727.591 51.26V69.668L682.663 6.79999H711.367L742.411 50.636L730.399 50.792L760.975 6.79999H788.431L743.815 68.576V50.48L791.083 116H761.911L729.775 69.668H741.319L709.651 116H680.635Z" fill="url(#tnxWmClientA)"></path>
              <defs>
                <linearGradient id="tnxWmClientA" x1="554" y1="0" x2="791" y2="119" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#B03A45"></stop>
                  <stop offset="1" stop-color="#6E1520"></stop>
                </linearGradient>
              </defs>
            </svg>
            <div class="font-medium text-[10.5px] leading-[1.5] text-[#858582]">
              Connect Everything.<br>Trust Nothing.
            </div>
          </div>

          <!-- Tabs (Connection, Settings, Logs) -->
          <div class="flex items-center gap-1">
            <button
              id="c-tab-conn"
              type="button"
              class="t-nav rounded-t-[8px] px-3.25 py-1.75 text-[13px] font-medium text-[#EDEDEB] bg-white/[0.08] border border-white/14 border-b-0"
            >
              Connection
            </button>
            <button
              id="c-tab-set"
              type="button"
              class="t-nav rounded-t-[8px] px-3.25 py-1.75 text-[13px] font-medium text-[#858582] bg-transparent border border-transparent"
            >
              Settings
            </button>
            <button
              id="c-tab-log"
              type="button"
              class="t-nav rounded-t-[8px] px-3.25 py-1.75 text-[13px] font-medium text-[#858582] bg-transparent border border-transparent"
            >
              Logs
            </button>
          </div>
        </div>

        <!-- Tab 1: Connection View -->
        <div id="c-view-conn" class="flex flex-col flex-1">
          <!-- Canvas Graph Well -->
          <div class="relative h-[248px] bg-[#0B0B0B]">
            <canvas id="tnxClient" class="absolute inset-0 size-full block"></canvas>
          </div>

          <!-- Connection Info & Stats -->
          <div class="p-[18px_18px_20px] flex flex-col gap-3.5 flex-1">
            <div>
              <div id="c-title" class="font-semibold text-[25px] leading-[1.15] text-[#F5F5F5] tracking-[-0.02em]">
                Not connected
              </div>
              <div id="c-sub" class="font-normal text-[13.5px] leading-[1.55] text-[#A9A9A6] mt-1 text-pretty">
                No tunnel, so no numbers. Counters read n/a rather than a comforting zero.
              </div>
            </div>

            <!-- Stats Box -->
            <div class="border border-white/16 rounded-[10px] p-3.5 flex flex-col gap-2.25">
              <div class="flex items-baseline gap-2.5">
                <span class="font-mono font-medium text-[10px] tracking-[0.12em] text-[#858582]">CONNECTION STATS</span>
                <span id="c-rate" class="ml-auto font-mono font-medium text-[15px] text-[#EDEDEB] tabular-nums">n/a</span>
              </div>

              <!-- Sparkline Canvas -->
              <div class="relative h-[44px]">
                <canvas id="tnxSpark" class="absolute inset-0 size-full block"></canvas>
              </div>

              <div class="flex items-baseline gap-2.5">
                <span id="c-peak-label" class="font-mono font-medium text-[10.5px] text-[#858582]">n/a peak</span>
                <span id="c-rate-sub" class="ml-auto font-mono font-medium text-[10.5px] text-[#858582]">n/a</span>
              </div>

              <div class="grid grid-cols-[auto_1fr_auto_1fr] gap-x-2.5 gap-y-1.75 items-baseline">
                <span class="font-mono font-medium text-[10.5px] text-[#858582]">BYTES IN ↓</span>
                <span id="c-in" class="text-right font-mono font-medium text-[11.5px] text-[#EDEDEB] tabular-nums">n/a</span>

                <span class="font-mono font-medium text-[10.5px] text-[#858582]">BYTES OUT ↑</span>
                <span id="c-out" class="text-right font-mono font-medium text-[11.5px] text-[#EDEDEB] tabular-nums">n/a</span>

                <span class="font-mono font-medium text-[10.5px] text-[#858582]">DURATION</span>
                <span id="c-dur" class="text-right font-mono font-medium text-[11.5px] text-[#EDEDEB] tabular-nums">n/a</span>

                <span class="font-mono font-medium text-[10.5px] text-[#858582]">LAST HANDSHAKE</span>
                <span id="c-shake" class="text-right font-mono font-medium text-[11.5px] text-[#EDEDEB] tabular-nums">n/a</span>

                <span class="font-mono font-medium text-[10.5px] text-[#858582]">TUNNEL IP</span>
                <span id="c-ip" class="text-right font-mono font-medium text-[11.5px] text-[#EDEDEB]">n/a</span>
              </div>
            </div>

            <!-- Action Button -->
            <button
              id="c-btn-action"
              type="button"
              class="t-btn mt-auto rounded-[9px] p-3.5 text-center text-[14.5px] font-semibold text-[#F7F5F5] bg-gradient-to-r from-[#B03A45] to-[#6E1520] border border-white/16 shadow-[0_8px_26px_-8px_rgba(176,58,69,0.65)]"
            >
              Connect
            </button>
          </div>
        </div>

        <!-- Tab 2: Settings View (Hidden by Default) -->
        <div id="c-view-set" class="hidden p-[20px_18px] flex-col gap-3.5">
          <!-- Routing Fieldset -->
          <div class="border border-white/16 rounded-[10px] p-[18px_16px_16px] relative">
            <span class="absolute -top-1.75 left-3.5 bg-[#141414] px-1.75 font-mono font-medium text-[10px] tracking-[0.12em] text-[#858582]">
              ROUTING
            </span>
            <div class="flex flex-col gap-3.25">
              <label class="flex gap-2.75 items-start cursor-pointer">
                <input type="radio" name="c-route" value="all" class="sr-only" id="c-route-all" />
                <div id="c-ring-all" class="size-[17px] flex-none mt-0.5 rounded-full border-[1.5px] border-white/28 flex items-center justify-center">
                  <div id="c-dot-all" class="size-2 rounded-full bg-transparent"></div>
                </div>
                <div>
                  <div class="font-medium text-[14px] text-[#EDEDEB]">All traffic</div>
                  <div class="font-normal text-[12.5px] leading-[1.5] text-[#858582] mt-0.5">Everything leaves through the tunnel, including your normal browsing.</div>
                </div>
              </label>

              <label class="flex gap-2.75 items-start cursor-pointer">
                <input type="radio" name="c-route" value="routes" checked class="sr-only" id="c-route-routes" />
                <div id="c-ring-routes" class="size-[17px] flex-none mt-0.5 rounded-full border-[1.5px] border-[#B03A45] flex items-center justify-center">
                  <div id="c-dot-routes" class="size-2 rounded-full bg-[#B03A45]"></div>
                </div>
                <div>
                  <div class="font-medium text-[14px] text-[#EDEDEB]">Only Tunnex routes</div>
                  <div class="font-normal text-[12.5px] leading-[1.5] text-[#858582] mt-0.5">Just the networks your admin published. Everything else uses your normal connection.</div>
                </div>
              </label>
              <div class="font-normal text-[12px] leading-[1.5] text-[#6E6E6B]">Changing this while connected re-issues the device configuration.</div>
            </div>
          </div>

          <!-- Profile -->
          <div class="border border-white/16 rounded-[10px] p-4 flex flex-col gap-2.5">
            <div class="font-mono font-medium text-[10px] tracking-[0.12em] text-[#858582]">PROFILE</div>
            <div class="font-normal text-[12.5px] leading-[1.6] text-[#A9A9A6] text-pretty">
              Signing in mints a device for you. If you were given a WireGuard <span class="font-mono font-medium text-[11.5px] text-[#D6D6D2]">.conf</span> when the device was created, import it instead.
            </div>
            <button id="c-btn-import" type="button" class="t-btn t-sec self-start rounded-[8px] p-[9px_14px] text-[12.5px] font-medium text-[#EDEDEB]">
              Import .conf
            </button>
          </div>

          <!-- About -->
          <div class="border border-white/16 rounded-[10px] p-4 flex flex-col gap-2">
            <div class="font-mono font-medium text-[10px] tracking-[0.12em] text-[#858582]">ABOUT</div>
            <div class="font-mono font-medium text-[13.5px] text-[#EDEDEB]">Tunnex v0.1.0</div>
            <div class="font-normal text-[12.5px] leading-[1.6] text-[#858582] text-pretty">
              Automatic updates are off in this build. Update by downloading a new build.
            </div>
          </div>

          <!-- Server -->
          <div class="border border-white/16 rounded-[10px] p-4 flex flex-col gap-2">
            <div class="font-mono font-medium text-[10px] tracking-[0.12em] text-[#858582]">SERVER</div>
            <div id="c-server" class="font-mono font-medium text-[13.5px] text-[#EDEDEB]">http://104.45.208.156</div>
            <div id="c-device" class="font-mono font-medium text-[11px] text-[#6E6E6B]">device 0f62edc39e8d</div>
            <div class="flex gap-2.25 mt-1 flex-wrap">
              <button id="c-btn-rotate" type="button" class="t-btn t-sec rounded-[8px] p-[9px_14px] text-[12.5px] font-medium text-[#EDEDEB]">
                Change server
              </button>
              <button id="c-btn-signout" type="button" class="t-btn t-sec rounded-[8px] p-[9px_14px] text-[12.5px] font-medium text-[#EDEDEB]">
                Sign out
              </button>
            </div>
          </div>
        </div>

        <!-- Tab 3: Logs View (Hidden by Default) -->
        <div id="c-view-log" class="hidden p-[18px] flex-col gap-3 flex-1">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <span class="font-mono font-medium text-[10px] tracking-[0.12em] text-[#858582]">CLIENT LOG</span>
            <div class="flex items-center gap-2">
              <button id="c-log-refresh" type="button" class="t-btn t-sec rounded-[8px] p-[7px_12px] text-[12px] font-medium text-[#EDEDEB]">Refresh</button>
              <button id="c-log-export" type="button" class="t-btn t-sec rounded-[8px] p-[7px_12px] text-[12px] font-medium text-[#EDEDEB]">Export</button>
              <button id="c-log-reveal" type="button" class="t-btn t-sec rounded-[8px] p-[7px_12px] text-[12px] font-medium text-[#EDEDEB]">Reveal</button>
            </div>
          </div>

          <div id="c-log-pane" class="flex-1 border border-white/16 rounded-[10px] p-3.25 bg-[#0B0B0B] overflow-y-auto max-h-[404px] flex flex-col gap-1.25">
            <!-- Logs injected via JS -->
          </div>
        </div>
      </div>

      <!-- Right Column: Features & SIMULATE Panel -->
      <div class="flex flex-col gap-[22px] pt-2">
        <div class="flex flex-col gap-3">
          <div class="tnx-eyebrow">THE DESKTOP CLIENT</div>
          <h2 class="tnx-h2">A client that only claims what the wire proves.</h2>
          <div class="tnx-body-lg">
            Reports live WireGuard handshakes directly. When disconnected, state counters read clear n/a instead of fake zeros.
          </div>
        </div>

        <!-- 4 Feature Rows -->
        <div class="flex flex-col gap-2.25">
          <!-- Feature 1 -->
          <div class="t-row flex items-start gap-3 rounded-[8px] p-[9px_10px] border border-white/[0.07] bg-[rgba(18,18,18,0.5)]">
            <div class="size-[28px] flex-none rounded-[8px] bg-[#1A1A1A] border border-[#2E2E2E] flex items-center justify-center text-[#C9C9C4]">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <div>
              <div class="font-semibold text-[13.5px] text-[#EDEDEB]">Kernel-level kill-switch</div>
              <div class="font-normal text-[12.5px] leading-[1.55] text-[#858582] mt-0.5 text-pretty">
                pf on macOS, WFP on Windows. Holds closed even if the process exits unexpectedly.
              </div>
            </div>
          </div>

          <!-- Feature 2 -->
          <div class="t-row flex items-start gap-3 rounded-[8px] p-[9px_10px] border border-white/[0.07] bg-[rgba(18,18,18,0.5)]">
            <div class="size-[28px] flex-none rounded-[8px] bg-[#1A1A1A] border border-[#2E2E2E] flex items-center justify-center text-[#C9C9C4]">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="19" r="3"></circle>
                <path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"></path>
                <circle cx="18" cy="5" r="3"></circle>
              </svg>
            </div>
            <div>
              <div class="font-semibold text-[13.5px] text-[#EDEDEB]">Split tunnel or all traffic</div>
              <div class="font-normal text-[12.5px] leading-[1.55] text-[#858582] mt-0.5 text-pretty">
                Toggle routing modes in Settings. Re-issues device configuration deterministically.
              </div>
            </div>
          </div>

          <!-- Feature 3 -->
          <div class="t-row flex items-start gap-3 rounded-[8px] p-[9px_10px] border border-white/[0.07] bg-[rgba(18,18,18,0.5)]">
            <div class="size-[28px] flex-none rounded-[8px] bg-[#1A1A1A] border border-[#2E2E2E] flex items-center justify-center text-[#C9C9C4]">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
              </svg>
            </div>
            <div>
              <div class="font-semibold text-[13.5px] text-[#EDEDEB]">Revocation-aware teardown</div>
              <div class="font-normal text-[12.5px] leading-[1.55] text-[#858582] mt-0.5 text-pretty">
                Admin revocation immediately tears down the tunnel and releases pool slots.
              </div>
            </div>
          </div>

          <!-- Feature 4 -->
          <div class="t-row flex items-start gap-3 rounded-[8px] p-[9px_10px] border border-white/[0.07] bg-[rgba(18,18,18,0.5)]">
            <div class="size-[28px] flex-none rounded-[8px] bg-[#1A1A1A] border border-[#2E2E2E] flex items-center justify-center text-[#C9C9C4]">
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </div>
            <div>
              <div class="font-semibold text-[13.5px] text-[#EDEDEB]">Clear diagnostic logs</div>
              <div class="font-normal text-[12.5px] leading-[1.55] text-[#858582] mt-0.5 text-pretty">
                Verbatim error traces, timestamps, and log exports for fast debugging.
              </div>
            </div>
          </div>
        </div>

        <!-- SIMULATE Panel -->
        <div class="bg-[rgba(18,18,18,0.72)] border border-white/[0.09] rounded-[8px] p-4 flex flex-col gap-2.75">
          <div class="font-mono font-semibold text-[9px] tracking-[0.16em] text-[#454542]">SIMULATE</div>
          <div class="flex items-center gap-2.25 flex-wrap">
            <button
              id="sim-fail"
              type="button"
              class="t-btn t-sec rounded-[8px] p-[9px_13px] font-mono text-[11px] font-semibold tracking-wider text-[#EDEDEB] cursor-pointer"
            >
              HANDSHAKE FAILURE
            </button>
            <button
              id="sim-revoke"
              type="button"
              class="t-btn t-sec rounded-[8px] p-[9px_13px] font-mono text-[11px] font-semibold tracking-wider text-[#EDEDEB] cursor-pointer"
            >
              ADMIN REVOKES DEVICE
            </button>
            <button
              id="sim-reset"
              type="button"
              class="t-btn t-sec rounded-[8px] p-[9px_13px] font-mono text-[11px] font-semibold tracking-wider text-[#EDEDEB] cursor-pointer"
            >
              RESET
            </button>
          </div>
          <div class="font-sans font-normal text-[12px] leading-[1.55] text-[#5E5E5B]">
            Illustrative telemetry with placeholder values. A revocation tears the tunnel down from the server side: the client does not get to disagree.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Client state management & simulator
  let cState = 'disconnected'; // 'disconnected' | 'connecting' | 'connected' | 'failed' | 'revoked'
  let cRoute = 'routes';
  let cIn = 0, cOut = 0, cPeak = 0, cShake = 0, cT0 = 0;
  let connectTimeout = null;
  let hist = [];

  const initialLogs = [
    { t: '20:34:20.181', lv: 'info', m: '--- tunnex client started ---' },
    { t: '20:34:20.243', lv: 'info', m: 'auto-update scaffolded but INERT (enabled once signing lands)' },
    { t: '20:34:21.902', lv: 'info', m: 'helper connected · pf ruleset anchor tunnex.killswitch loaded' },
    { t: '20:34:22.118', lv: 'info', m: 'policy artifact rev 41 received · 6 allow rules compiled' },
    { t: '20:36:04.550', lv: 'info', m: 'posture report sent · os 15.5 · disk encryption ON' },
    { t: '20:41:17.309', lv: 'warn', m: 'handshake retry 1/3 · no response from gateway ap-lan' },
    { t: '20:41:19.884', lv: 'info', m: 'handshake ok · peer syd-gw-01 · tunnel ip 10.99.0.7/32' },
    { t: '20:58:36.682', lv: 'error', m: "handler 'tunnel:status' failed: helper connection closed" },
    { t: '20:58:36.684', lv: 'info', m: 'kill-switch held closed through helper restart: no leak window' }
  ];
  let logs = [...initialLogs];

  function fmtBytes(n) {
    if (n < 1024) return n.toFixed(2) + ' B';
    if (n < 1048576) return (n / 1024).toFixed(2) + ' KiB';
    return (n / 1048576).toFixed(2) + ' MiB';
  }

  function addLog(lv, m) {
    const d = new Date();
    const p = n => String(n).padStart(2, '0');
    const t = `${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}.${String(d.getMilliseconds()).padStart(3, '0')}`;
    logs.push({ t, lv, m });
    if (logs.length > 60) logs.shift();
    renderLogs();
  }

  function renderLogs() {
    const pane = document.getElementById('c-log-pane');
    if (!pane) return;
    pane.innerHTML = logs.slice().reverse().map(l => {
      const color = l.lv === 'error' ? '#C4626C' : (l.lv === 'warn' ? '#C39A4E' : '#A9A9A6');
      return `<div style="font:400 11px/1.45 'JetBrains Mono',monospace;color:${color};word-break:break-word">[2026-08-04 ${l.t}] [${l.lv}] ${l.m}</div>`;
    }).join('');
  }

  function updateUI() {
    const title = document.getElementById('c-title');
    const sub = document.getElementById('c-sub');
    const rate = document.getElementById('c-rate');
    const rateSub = document.getElementById('c-rate-sub');
    const peakLabel = document.getElementById('c-peak-label');
    const cin = document.getElementById('c-in');
    const cout = document.getElementById('c-out');
    const cdur = document.getElementById('c-dur');
    const cshake = document.getElementById('c-shake');
    const cip = document.getElementById('c-ip');
    const btn = document.getElementById('c-btn-action');

    const isConn = cState === 'connected';
    const dur = isConn ? Math.floor((Date.now() - cT0) / 1000) : 0;
    const curRate = isConn && hist.length ? hist[hist.length - 1] : 0;

    if (cState === 'disconnected') {
      if (title) title.textContent = 'Not connected';
      if (sub) sub.textContent = 'No tunnel, so no numbers. Counters read n/a rather than a comforting zero.';
    } else if (cState === 'connecting') {
      if (title) title.textContent = 'Connecting…';
      if (sub) sub.textContent = 'Requesting a device configuration, then waiting on the handshake.';
    } else if (cState === 'connected') {
      if (title) title.textContent = 'Connected';
      if (sub) sub.textContent = 'Handshake fresh: traffic is flowing through the mesh.';
    } else if (cState === 'failed') {
      if (title) title.textContent = 'Connection failed';
      if (sub) sub.textContent = 'The tunnel could not be established. Retrying will re-request a config.';
    } else if (cState === 'revoked') {
      if (title) title.textContent = 'Device revoked';
      if (sub) sub.textContent = 'An admin revoked this device. The kill-switch is engaged and traffic has stopped.';
    }

    if (rate) rate.textContent = isConn ? fmtBytes(curRate) + '/s' : 'n/a';
    if (rateSub) rateSub.textContent = isConn ? fmtBytes(curRate) + '/s' : 'n/a';
    if (peakLabel) peakLabel.textContent = isConn && cPeak ? fmtBytes(cPeak) + ' peak' : 'n/a peak';
    if (cin) cin.textContent = isConn ? fmtBytes(cIn) : 'n/a';
    if (cout) cout.textContent = isConn ? fmtBytes(cOut) : 'n/a';
    if (cdur) cdur.textContent = isConn ? `${Math.floor(dur / 60)}:${String(dur % 60).padStart(2, '0')}` : 'n/a';
    if (cshake) cshake.textContent = isConn ? `${cShake}s ago` : 'n/a';
    if (cip) cip.textContent = isConn ? '10.99.0.7/32' : 'n/a';

    if (btn) {
      if (cState === 'connected') {
        btn.textContent = 'Disconnect';
        btn.className = "t-btn mt-auto rounded-[9px] p-3.5 text-center text-[14.5px] font-semibold text-[#EDEDEB] bg-white/[0.06] border border-white/18";
      } else if (cState === 'connecting') {
        btn.textContent = 'Connecting…';
        btn.className = "t-btn mt-auto rounded-[9px] p-3.5 text-center text-[14.5px] font-semibold text-[#F7F5F5] bg-white/10 border border-white/16";
      } else {
        btn.textContent = cState === 'disconnected' ? 'Connect' : 'Retry';
        btn.className = "t-btn mt-auto rounded-[9px] p-3.5 text-center text-[14.5px] font-semibold text-[#F7F5F5] bg-gradient-to-r from-[#B03A45] to-[#6E1520] border border-white/16 shadow-[0_8px_26px_-8px_rgba(176,58,69,0.65)]";
      }
    }
  }

  function setCState(next) {
    clearTimeout(connectTimeout);
    if (next === 'connecting') {
      hist = [];
      cState = 'connecting';
      cIn = 0; cOut = 0; cPeak = 0; cShake = 0; cT0 = Date.now();
      updateUI();
      addLog('info', 'requesting device configuration · ' + (cRoute === 'all' ? 'full-tunnel' : 'split-tunnel'));
      connectTimeout = setTimeout(() => {
        cState = 'connected';
        cT0 = Date.now();
        cShake = 0;
        updateUI();
        addLog('info', 'handshake ok · peer syd-gw-01 · tunnel ip 10.99.0.7/32');
      }, 1700);
    } else if (next === 'failed') {
      cState = 'failed';
      updateUI();
      addLog('error', 'tunnel could not be established · no handshake response after 3 retries');
    } else if (next === 'revoked') {
      cState = 'revoked';
      updateUI();
      addLog('warn', 'device revoked by admin · peer slot and pool address released');
      addLog('info', 'kill-switch engaged · traffic stopped rather than falling back');
    } else {
      cState = 'disconnected';
      updateUI();
      addLog('info', 'tunnel down · pf anchor flushed · interface removed');
    }
  }

  // Telemetry beat timer
  setInterval(() => {
    if (cState !== 'connected') return;
    const din = 40 + Math.random() * 210;
    const dout = 26 + Math.random() * 150;
    hist.push(din + dout);
    if (hist.length > 56) hist.shift();
    cIn += din;
    cOut += dout;
    cPeak = Math.max(cPeak, din + dout);
    cShake++;
    if (cShake % 25 === 0) addLog('info', 'handshake refreshed · peer syd-gw-01 · rekey ok');
    updateUI();
  }, 1000);

  // Tab switching
  const tabConn = document.getElementById('c-tab-conn');
  const tabSet = document.getElementById('c-tab-set');
  const tabLog = document.getElementById('c-tab-log');
  const viewConn = document.getElementById('c-view-conn');
  const viewSet = document.getElementById('c-view-set');
  const viewLog = document.getElementById('c-view-log');

  function switchTab(t) {
    [tabConn, tabSet, tabLog].forEach(btn => {
      if (!btn) return;
      btn.className = "t-nav rounded-t-[8px] px-3.25 py-1.75 text-[13px] font-medium text-[#858582] bg-transparent border border-transparent";
    });
    [viewConn, viewSet, viewLog].forEach(v => {
      if (!v) return;
      v.classList.remove('flex', 'flex-col');
      v.classList.add('hidden');
    });

    if (t === 'conn') {
      tabConn.className = "t-nav rounded-t-[8px] px-3.25 py-1.75 text-[13px] font-medium text-[#EDEDEB] bg-white/[0.08] border border-white/14 border-b-0";
      viewConn.classList.remove('hidden');
      viewConn.classList.add('flex', 'flex-col');
    } else if (t === 'set') {
      tabSet.className = "t-nav rounded-t-[8px] px-3.25 py-1.75 text-[13px] font-medium text-[#EDEDEB] bg-white/[0.08] border border-white/14 border-b-0";
      viewSet.classList.remove('hidden');
      viewSet.classList.add('flex', 'flex-col');
    } else if (t === 'log') {
      tabLog.className = "t-nav rounded-t-[8px] px-3.25 py-1.75 text-[13px] font-medium text-[#EDEDEB] bg-white/[0.08] border border-white/14 border-b-0";
      viewLog.classList.remove('hidden');
      viewLog.classList.add('flex', 'flex-col');
      renderLogs();
    }
  }

  tabConn?.addEventListener('click', () => switchTab('conn'));
  tabSet?.addEventListener('click', () => switchTab('set'));
  tabLog?.addEventListener('click', () => switchTab('log'));

  // Action Button
  const btnAction = document.getElementById('c-btn-action');
  btnAction?.addEventListener('click', () => {
    if (cState === 'connecting') return;
    setCState(cState === 'connected' ? 'disconnected' : 'connecting');
  });

  // Simulator Buttons
  document.getElementById('sim-fail')?.addEventListener('click', () => setCState('failed'));
  document.getElementById('sim-revoke')?.addEventListener('click', () => setCState('revoked'));
  document.getElementById('sim-reset')?.addEventListener('click', () => setCState('disconnected'));

  // Routing Radio Buttons
  const routeAll = document.getElementById('c-route-all');
  const routeRoutes = document.getElementById('c-route-routes');
  const ringAll = document.getElementById('c-ring-all');
  const dotAll = document.getElementById('c-dot-all');
  const ringRoutes = document.getElementById('c-ring-routes');
  const dotRoutes = document.getElementById('c-dot-routes');

  function updateRoute(v) {
    cRoute = v;
    if (v === 'all') {
      ringAll.style.borderColor = '#B03A45'; dotAll.style.backgroundColor = '#B03A45';
      ringRoutes.style.borderColor = 'rgba(255,255,255,0.28)'; dotRoutes.style.backgroundColor = 'transparent';
    } else {
      ringRoutes.style.borderColor = '#B03A45'; dotRoutes.style.backgroundColor = '#B03A45';
      ringAll.style.borderColor = 'rgba(255,255,255,0.28)'; dotAll.style.backgroundColor = 'transparent';
    }
    addLog('info', 'routing mode → ' + (v === 'all' ? 'full-tunnel' : 'split-tunnel') + (cState === 'connected' ? ' · re-issuing device configuration' : ''));
  }

  routeAll?.addEventListener('change', () => updateRoute('all'));
  routeRoutes?.addEventListener('change', () => updateRoute('routes'));

  // Canvas Canvas Animations (rAF)
  let clFactor = 0;
  function drawCanvas() {
    const cv = document.getElementById('tnxClient');
    if (cv && cv.clientWidth) {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = cv.clientWidth, h = cv.clientHeight;
      if (cv.width !== Math.round(w * dpr)) { cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr); }
      const ctx = cv.getContext('2d');
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, w, h);

      const on = cState === 'connected', mid = cState === 'connecting';
      const target = on ? 1 : (mid ? 0.62 : 0);
      clFactor += (target - clFactor) * 0.06;
      const L = clFactor, cx = w / 2, cy = h / 2, rx = w * 0.36, ry = h * 0.34, now = Date.now();
      const N = 9, pts = [];

      for (let i = 0; i < N; i++) {
        const a = -Math.PI / 2 + (i / N) * Math.PI * 2 + (i % 2 ? 0.14 : -0.09);
        pts.push({
          x: cx + Math.cos(a) * rx * (0.94 + Math.sin(now / 1000 + i) * 0.04),
          y: cy + Math.sin(a) * ry * (0.94 + Math.cos(now / 1000 + i) * 0.04),
          s: i / N * 0.5
        });
      }

      pts.forEach(p => {
        const e = Math.max(0, Math.min(1, (L - p.s) / 0.4));
        if (e > 0) {
          ctx.strokeStyle = 'rgba(232,232,228,' + (0.1 + e * 0.24).toFixed(3) + ')'; ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + (p.x - cx) * e, cy + (p.y - cy) * e); ctx.stroke();
          if (e > 0.97 && on) {
            const tp = ((now / 1500) + p.s) % 1;
            ctx.fillStyle = 'rgba(232,232,228,' + Math.max(0, 0.9 * (1 - Math.abs(tp - 0.5) * 1.2)).toFixed(3) + ')';
            ctx.beginPath(); ctx.arc(cx + (p.x - cx) * tp, cy + (p.y - cy) * tp, 2, 0, 6.2832); ctx.fill();
          }
        }
        const rr = Math.max(1.4, 2 + e * 3.4);
        ctx.fillStyle = 'rgba(232,232,228,' + (0.22 + e * 0.72).toFixed(3) + ')';
        ctx.beginPath(); ctx.arc(p.x, p.y, rr, 0, 6.2832); ctx.fill();
        if (e > 0.9) { ctx.strokeStyle = 'rgba(232,232,228,.34)'; ctx.lineWidth = 1.1; ctx.beginPath(); ctx.arc(p.x, p.y, rr + 3.4, 0, 6.2832); ctx.stroke(); }
      });

      if (L > 0.6) {
        const ra = (L - 0.6) / 0.4;
        for (let i = 0; i < pts.length; i++) {
          const a = pts[i], b = pts[(i + 1) % pts.length];
          ctx.strokeStyle = 'rgba(255,255,255,' + (ra * 0.12).toFixed(3) + ')'; ctx.lineWidth = 0.8;
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
        }
      }

      const core = 8 + L * 3.4, warm = cState === 'revoked' || cState === 'failed';
      const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, core * 3.4);
      g.addColorStop(0, warm ? 'rgba(196,98,108,.2)' : 'rgba(255,255,255,.17)');
      g.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(cx, cy, core * 3.4, 0, 6.2832); ctx.fill();
      ctx.fillStyle = warm ? '#C4626C' : '#D8D8D4';
      ctx.beginPath(); ctx.arc(cx, cy, core * 0.6, 0, 6.2832); ctx.fill();
      if (on || mid) {
        const pt = (now % 2600) / 2600;
        ctx.strokeStyle = 'rgba(232,232,228,' + ((1 - pt) * 0.34).toFixed(3) + ')'; ctx.lineWidth = 1.3;
        ctx.beginPath(); ctx.arc(cx, cy, core + pt * 32, 0, 6.2832); ctx.stroke();
      }
    }

    // Sparkline Canvas
    const sp = document.getElementById('tnxSpark');
    if (sp && sp.clientWidth) {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = sp.clientWidth, h = sp.clientHeight;
      if (sp.width !== Math.round(w * dpr)) { sp.width = Math.round(w * dpr); sp.height = Math.round(h * dpr); }
      const ctx = sp.getContext('2d');
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, w, h);
      ctx.strokeStyle = 'rgba(255,255,255,.1)'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(0, h * 0.58); ctx.lineTo(w, h * 0.58); ctx.stroke();
      if (hist.length > 1) {
        const mx = Math.max.apply(null, hist) || 1, step = w / 55;
        ctx.strokeStyle = 'rgba(237,237,235,.9)'; ctx.lineWidth = 1.3; ctx.beginPath();
        hist.forEach((v, i) => { const x = i * step, y = h - 3 - (v / mx) * (h - 9); i ? ctx.lineTo(x, y) : ctx.moveTo(x, y); });
        ctx.stroke();
      }
    }

    requestAnimationFrame(drawCanvas);
  }

  // Initial setup
  renderLogs();
  updateUI();
  drawCanvas();
</script>
