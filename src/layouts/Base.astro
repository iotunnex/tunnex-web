---
import { PUBLIC_CF_ANALYTICS_TOKEN } from 'astro:env/client';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Canonical URL path (e.g. `/blog/foo/`) — emitted absolute against site. */
  canonical?: string;
  /** Site-relative OG image path; presence opts the page into OG/Twitter cards. */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Self-hosted Zero Trust VPN. Connect everything. Trust nothing.',
  noindex = false,
  canonical,
  ogImage,
  ogType = 'website',
} = Astro.props;

const site = Astro.site ?? new URL('https://tunnex.io');

// Site-wide SEO defaults (S4.2): indexable pages get a canonical (their clean
// path, no query) and the default OG card automatically; explicit props still
// win (blog posts pass their own). noindex pages get neither — no canonical to
// a token URL, no card for a utility page.
const resolvedCanonical = canonical ?? (noindex ? undefined : Astro.url.pathname);
const resolvedOgImage = ogImage ?? (noindex ? undefined : '/og/default.png');
const canonicalUrl = resolvedCanonical ? new URL(resolvedCanonical, site).href : undefined;
const ogImageUrl = resolvedOgImage ? new URL(resolvedOgImage, site).href : undefined;

const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.href}#website`,
      url: site.href,
      name: 'Tunnex',
      description: 'Self-hosted Zero Trust VPN for People, Workloads & AI Agents',
      publisher: {
        '@id': `${site.href}#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${site.href}#organization`,
      name: 'Tunnex',
      url: site.href,
      description: 'Self-hosted Zero Trust VPN.',
      logo: new URL('/icon-512.png', site).href,
      email: 'sales@tunnex.io',
      sameAs: ['https://github.com/iotunnex/tunnex'],
    },
  ],
});
---

<!doctype html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Tunnex Blog" href="/blog/rss.xml" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      ogImageUrl && (
        <>
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:type" content={ogType} />
          {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={title} />
          <meta property="og:site_name" content="Tunnex" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={ogImageUrl} />
          <meta name="twitter:image:alt" content={title} />
        </>
      )
    }
    <script type="application/ld+json" set:html={orgJsonLd} is:inline />
    <slot name="head" />
    <title>{title}</title>
    <script is:inline>
      // Pre-paint theme init: dark is the default; an explicit stored choice
      // wins (including one made on the Starlight docs pages). Runs before
      // first paint so there is no flash or layout shift. data-theme is
      // stamped alongside the class: Expressive Code (code blocks) themes on
      // [data-theme], the token system honors both.
      {
        const mode = localStorage.getItem('theme') ?? localStorage.getItem('starlight-theme');
        if (mode === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.dataset.theme = 'light';
        }
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-text antialiased">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    {
      /* Cloudflare Web Analytics — cookieless, no cross-site tracking, so no
         consent banner (said plainly on /privacy). Only ships when the token
         is set. */
      PUBLIC_CF_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${PUBLIC_CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </body>
</html>
