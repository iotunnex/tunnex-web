---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Self-hosted Zero Trust VPN. Your keys. Your servers. Your network.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <script is:inline>
      // Pre-paint theme init: dark is the default; an explicit stored choice
      // wins (including one made on the Starlight docs pages). Runs before
      // first paint so there is no flash or layout shift.
      {
        const mode = localStorage.getItem('theme') ?? localStorage.getItem('starlight-theme');
        if (mode === 'light') document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-text antialiased">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
